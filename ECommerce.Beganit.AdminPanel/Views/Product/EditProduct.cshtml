@model ECommerce.Beganit.AdminPanel.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
    var commonAttributes = new List<string> { "Color", "Size", "Material", "Weight", "Dimensions", "Pattern", "Warranty", "Capacity" };
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="card border-0 shadow-sm mb-4 bg-gradient-primary">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white p-3 me-3 shadow-sm">
                    <i class="bi bi-box-seam text-primary fs-3"></i>
                </div>
                <div class="text-white">
                    <h1 class="h3 mb-0">@(Model.Id > 0 ? "Edit" : "Create") Product</h1>
                    <p class="mb-0 opacity-75">Manage product details, pricing, inventory and more</p>
                </div>
                <div class="ms-auto">
                    <a asp-action="Index" class="btn btn-light me-2">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#helpModal">
                        <i class="bi bi-question-circle me-1"></i> Help
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <ul class="nav nav-tabs card-header-tabs" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">
                                <i class="bi bi-info-circle me-1"></i> Basic Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing" type="button" role="tab" aria-controls="pricing" aria-selected="false">
                                <i class="bi bi-currency-dollar me-1"></i> Pricing
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory" type="button" role="tab" aria-controls="inventory" aria-selected="false">
                                <i class="bi bi-box-seam me-1"></i> Inventory
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="dimensions-tab" data-bs-toggle="tab" data-bs-target="#dimensions" type="button" role="tab" aria-controls="dimensions" aria-selected="false">
                                <i class="bi bi-rulers me-1"></i> Dimensions
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="attributes-tab" data-bs-toggle="tab" data-bs-target="#attributes" type="button" role="tab" aria-controls="attributes" aria-selected="false">
                                <i class="bi bi-list-check me-1"></i> Attributes
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="images-tab" data-bs-toggle="tab" data-bs-target="#images" type="button" role="tab" aria-controls="images" aria-selected="false">
                                <i class="bi bi-images me-1"></i> Images
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories" aria-selected="false">
                                <i class="bi bi-tags me-1"></i> Categories
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="metadata-tab" data-bs-toggle="tab" data-bs-target="#metadata" type="button" role="tab" aria-controls="metadata" aria-selected="false">
                                <i class="bi bi-file-earmark-text me-1"></i> Metadata
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <form id="productForm" asp-action="EditProduct" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="tab-content" id="productTabsContent">
                            <!-- Basic Info Tab -->
                            <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
                                <div class="row g-4">
                                    @if (Model.Id > 0)
                                    {
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Id" class="form-label fw-semibold">Product Id</label>
                                                <input asp-for="Id" disabled class="form-control bg-light" />
                                                <div class="form-text">Product Id - not editable, Auto-Increment</div>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                                            <input asp-for="Name" class="form-control" required maxlength="255" />
                                            <span asp-validation-for="Name" class="text-danger small"></span>
                                            <div class="form-text">Enter a descriptive name for your product (max 255 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Slug" class="form-label fw-semibold">URL Slug <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">/product/</span>
                                                <input asp-for="Slug" class="form-control" required pattern="[a-z0-9-]+" />
                                                <button type="button" id="generateSlugBtn" class="btn btn-outline-secondary">
                                                    <i class="bi bi-magic"></i> Generate
                                                </button>
                                            </div>
                                            <span asp-validation-for="Slug" class="text-danger small"></span>
                                            <div class="form-text">Used in the URL (e.g., example.com/product/your-slug). Use only lowercase letters, numbers, and hyphens.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="text-danger">*</span></label>
                                            <select asp-for="BrandId" class="form-select" required>
                                                <option value="">-- Select Brand --</option>
                                                @if (ViewBag.Brands != null)
                                                {
                                                    foreach (var brand in ViewBag.Brands)
                                                    {
                                                        <option value="@brand.Id">@brand.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                                            <div class="form-text">Select the manufacturer or brand of this product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Sku" class="form-label fw-semibold">SKU <span class="text-danger">*</span></label>
                                            <input asp-for="Sku" class="form-control" required maxlength="50" />
                                            <span asp-validation-for="Sku" class="text-danger small"></span>
                                            <div class="form-text">Stock Keeping Unit - unique identifier for this product</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="ShortDescription" class="form-label fw-semibold">Short Description <span class="text-danger">*</span></label>
                                            <input asp-for="ShortDescription" class="form-control" required maxlength="1000" />
                                            <div class="d-flex justify-content-between">
                                                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                                                <small class="text-muted" id="shortDescCounter">0/160</small>
                                            </div>
                                            <div class="form-text">Brief summary shown in product listings (max 1000 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="Description" class="form-label fw-semibold">Full Description <span class="text-danger">*</span></label>
                                            <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
                                            <span asp-validation-for="Description" class="text-danger small"></span>
                                            <div class="form-text">Detailed product description shown on the product page</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pricing Tab -->
                            <div class="tab-pane fade" id="pricing" role="tabpanel" aria-labelledby="pricing-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="RegularPrice" class="form-label fw-semibold">Regular Price <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="RegularPrice" class="form-control" type="number" step="0.01" min="0" required />
                                            </div>
                                            <span asp-validation-for="RegularPrice" class="text-danger small"></span>
                                            <div class="form-text">The normal, non-discounted price of the product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountPrice" class="form-label fw-semibold">Discount Price</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                                                <button type="button" id="calculateDiscountBtn" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#discountCalculatorModal">
                                                    <i class="bi bi-calculator"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                                            <div class="form-text">Leave empty if no discount is applied</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountStartDate" class="form-label fw-semibold">Discount Start Date</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-calendar-event"></i>
                                                </span>
                                                <input asp-for="DiscountStartDate" class="form-control" type="datetime-local" />
                                            </div>
                                            <span asp-validation-for="DiscountStartDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period begins</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountEndDate" class="form-label fw-semibold">Discount End Date</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-calendar-event"></i>
                                                </span>
                                                <input asp-for="DiscountEndDate" class="form-control" type="datetime-local" />
                                            </div>
                                            <span asp-validation-for="DiscountEndDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period ends</div>
                                        </div>
                                    </div>

                                    @if (Model.RegularPrice > 0 && Model.DiscountPrice > 0)
                                    {
                                        <div class="col-12">
                                            <div class="alert alert-info py-3">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                    <div>
                                                        <h6 class="mb-1">Discount Summary</h6>
                                                        <p class="mb-0">
                                                            Discount amount: <strong>$@(Model.RegularPrice - Model.DiscountPrice)</strong> |
                                                            Discount percentage: <strong>@(Math.Round((1 - Model.DiscountPrice ?? 0 / Model.RegularPrice) * 100, 2))%</strong>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Inventory Tab -->
                            <div class="tab-pane fade" id="inventory" role="tabpanel" aria-labelledby="inventory-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Quantity" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-boxes"></i>
                                                </span>
                                                <input asp-for="Quantity" class="form-control" type="number" min="0" required />
                                            </div>
                                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                                            <div class="form-text">Current inventory level</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Stock Status</label>
                                            <div class="form-text mb-2">Automatically calculated based on quantity</div>
                                            <div class="d-flex align-items-center">
                                                @if (Model.Quantity > 0)
                                                {
                                                    <span class="badge bg-success me-2 px-3 py-2">In Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger me-2 px-3 py-2">Out of Stock</span>
                                                }
                                                <span class="text-muted small">Based on current quantity</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsActiveInput">Product Active</label>
                                            <div class="form-check form-switch form-switch-lg">
                                                <input asp-for="IsActive" class="form-check-input" id="IsActiveInput" />
                                                <label class="form-check-label" for="IsActiveInput">
                                                    @(Model.IsActive ? "Product is visible on the store" : "Product is hidden from customers")
                                                </label>
                                            </div>
                                            <div class="form-text">Toggle to show or hide the product on the store</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsFeaturedInput">Featured Product</label>
                                            <div class="form-check form-switch form-switch-lg">
                                                <input asp-for="IsFeatured" class="form-check-input" id="IsFeaturedInput" />
                                                <label class="form-check-label" for="IsFeaturedInput">
                                                    @(Model.IsFeatured ? "Product appears in featured sections" : "Product does not appear in featured sections")
                                                </label>
                                            </div>
                                            <div class="form-text">Featured products appear in special sections on the homepage and category pages</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-warning py-3 mt-3">
                                            <div class="d-flex">
                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Low Stock Warning</h6>
                                                    <p class="mb-0">Set up low stock notifications in the <a href="#" class="alert-link">Inventory Settings</a> page.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dimensions Tab -->
                            <div class="tab-pane fade" id="dimensions" role="tabpanel" aria-labelledby="dimensions-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Weight" class="form-label fw-semibold">Weight (kg)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-speedometer2"></i>
                                                </span>
                                                <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                                                <span class="input-group-text">kg</span>
                                            </div>
                                            <span asp-validation-for="Weight" class="text-danger small"></span>
                                            <div class="form-text">Product weight used for shipping calculations</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="alert alert-info py-3">
                                            <div class="d-flex">
                                                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Shipping Information</h6>
                                                    <p class="mb-0">Accurate dimensions ensure correct shipping rates and packaging.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Length" class="form-label fw-semibold">Length (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Length" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Length" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Width" class="form-label fw-semibold">Width (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Width" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Width" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Height" class="form-label fw-semibold">Height (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Height" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Height" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="card bg-light border-0 shadow-sm">
                                            <div class="card-body">
                                                <h6 class="card-title d-flex align-items-center">
                                                    <i class="bi bi-calculator me-2 text-primary"></i>
                                                    Calculated Volume
                                                </h6>
                                                <p class="card-text" id="volumeCalculation">
                                                    @if (Model.Length > 0 && Model.Width > 0 && Model.Height > 0)
                                                    {
                                                        <span>@(Model.Length * Model.Width * Model.Height) cm³</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Enter dimensions to calculate volume</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attributes Tab - NEW -->
                            <div class="tab-pane fade" id="attributes" role="tabpanel" aria-labelledby="attributes-tab">
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <div class="alert alert-info d-flex align-items-center">
                                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                            <div>
                                                <h6 class="mb-1">Product Attributes</h6>
                                                <p class="mb-0">Attributes help customers find and filter products. Add attributes like color, size, material, etc.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-5">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-plus-circle me-2 text-primary"></i>Add Attribute
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-3">
                                                    <label for="attributeNameInput" class="form-label">Attribute Name</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light">
                                                            <i class="bi bi-tag"></i>
                                                        </span>
                                                        <input type="text" id="attributeNameInput" class="form-control" placeholder="e.g. Color, Size, Material" list="commonAttributesList" />
                                                        <datalist id="commonAttributesList">
                                                            @foreach (var attr in commonAttributes)
                                                            {
                                                                <option value="@attr">@attr</option>
                                                            }
                                                        </datalist>
                                                    </div>
                                                    <div class="form-text">Choose from common attributes or enter a custom one</div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="attributeValueInput" class="form-label">Attribute Value</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light">
                                                            <i class="bi bi-input-cursor-text"></i>
                                                        </span>
                                                        <input type="text" id="attributeValueInput" class="form-control" placeholder="e.g. Red, XL, Cotton" />
                                                    </div>
                                                    <div class="form-text">Enter the specific value for this attribute</div>
                                                </div>

                                                <div id="commonValuesContainer" class="d-none mb-3">
                                                    <label class="form-label">Common Values</label>
                                                    <div id="commonValuesList" class="d-flex flex-wrap gap-1">
                                                        <!-- Populated dynamically by JavaScript -->
                                                    </div>
                                                </div>

                                                <div class="d-grid mt-4">
                                                    <button type="button" id="addAttributeBtn" class="btn btn-primary">
                                                        <i class="bi bi-plus-lg me-1"></i> Add Attribute
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-list-check me-2 text-primary"></i>Product Attributes
                                                </h5>
                                                <span class="badge bg-primary rounded-pill" id="attributeCount">
                                                    @(Model.Attributes?.Count ?? 0)
                                                </span>
                                            </div>
                                            <div class="card-body">
                                                <div id="attributesContainer">
                                                    @if (Model.Attributes != null && Model.Attributes.Count > 0)
                                                    {
                                                        foreach (var attr in Model.Attributes)
                                                        {
                                                            <div class="attribute-row mb-3 p-3 border rounded bg-light position-relative">
                                                                <button type="button" class="btn-close position-absolute top-0 end-0 m-2 remove-attribute" aria-label="Remove"></button>
                                                                <div class="row g-3">
                                                                    <div class="col-md-5">
                                                                        <label class="form-label small fw-medium">Attribute Name</label>
                                                                        <input type="text" name="Attributes[@(Model.Attributes.ToList().IndexOf(attr))].AttributeName" class="form-control attribute-name" value="@attr.AttributeName" readonly />
                                                                        <input type="hidden" name="Attributes[@(Model.Attributes.ToList().IndexOf(attr))].Id" value="@attr.Id" />
                                                                        <input type="hidden" name="Attributes[@(Model.Attributes.ToList().IndexOf(attr))].ProductId" value="@attr.ProductId" />
                                                                    </div>
                                                                    <div class="col-md-7">
                                                                        <label class="form-label small fw-medium">Attribute Value</label>
                                                                        <input type="text" name="Attributes[@(Model.Attributes.ToList().IndexOf(attr))].AttributeValue" class="form-control attribute-value" value="@attr.AttributeValue" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div id="noAttributesMessage" class="text-center py-5">
                                                            <div class="mb-3">
                                                                <i class="bi bi-tags text-muted fs-1"></i>
                                                            </div>
                                                            <h6 class="text-muted">No attributes added yet</h6>
                                                            <p class="text-muted mb-0">Add attributes to help customers find your product</p>
                                                        </div>
                                                    }
                                                </div>
