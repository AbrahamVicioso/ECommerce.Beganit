                                                    <button type="button" id="clearAttributesBtn" class="btn btn-sm btn-outline-danger" @(Model.Attributes == null || Model.Attributes.Count == 0 ? "disabled" : "")>
                                                        <i class="bi bi-trash me-1"></i> Clear All
