@model ECommerce.Beganit.AdminPanel.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#helpModal">
                        <i class="bi bi-question-circle"></i> Help
                    </button>
                </div>
                <h4 class="m-0">@(Model.Id > 0 ? "Edit" : "Create") Product</h4>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <ul class="nav nav-tabs card-header-tabs" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">
                                <i class="bi bi-info-circle me-1"></i> Basic Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing" type="button" role="tab" aria-controls="pricing" aria-selected="false">
                                <i class="bi bi-currency-dollar me-1"></i> Pricing
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory" type="button" role="tab" aria-controls="inventory" aria-selected="false">
                                <i class="bi bi-box-seam me-1"></i> Inventory
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="dimensions-tab" data-bs-toggle="tab" data-bs-target="#dimensions" type="button" role="tab" aria-controls="dimensions" aria-selected="false">
                                <i class="bi bi-rulers me-1"></i> Dimensions
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="images-tab" data-bs-toggle="tab" data-bs-target="#images" type="button" role="tab" aria-controls="images" aria-selected="false">
                                <i class="bi bi-images me-1"></i> Images
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="images-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="images" aria-selected="false">
                                <i class="bi bi-tags me-1"></i>Categories
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="metadata-tab" data-bs-toggle="tab" data-bs-target="#metadata" type="button" role="tab" aria-controls="metadata" aria-selected="false">
                                <i class="bi bi-file-earmark-text me-1"></i> Metadata
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <form id="formulario" asp-action="EditProduct" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="tab-content" id="productTabsContent">
                            <!-- Basic Info Tab -->
                            <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
                                <div class="row g-4">
                                    @if (Model.Id > 0)
                                    {
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="Id" class="form-label fw-semibold">Product Id</label>
                                                <input asp-for="Id" disabled class="form-control bg-light" />
                                                <div class="form-text">Product Id - not editable, Auto-Increment</div>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                                            <input asp-for="Name" class="form-control" required maxlength="255" />
                                            <span asp-validation-for="Name" class="text-danger small"></span>
                                            <div class="form-text">Enter a descriptive name for your product (max 255 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Slug" class="form-label fw-semibold">URL Slug <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">/product/</span>
                                                <input asp-for="Slug" class="form-control" required pattern="[a-z0-9-]+" />
                                                <button type="button" id="generateSlugBtn" class="btn btn-outline-secondary">
                                                    <i class="bi bi-magic"></i> Generate
                                                </button>
                                            </div>
                                            <span asp-validation-for="Slug" class="text-danger small"></span>
                                            <div class="form-text">Used in the URL (e.g., example.com/product/your-slug). Use only lowercase letters, numbers, and hyphens.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="text-danger">*</span></label>
                                            <select asp-for="BrandId" class="form-select" required>
                                                <option value="">-- Select Brand --</option>
                                                @if (ViewBag.Brands != null)
                                                {
                                                    foreach (var brand in ViewBag.Brands)
                                                    {
                                                        <option value="@brand.Id">@brand.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                                            <div class="form-text">Select the manufacturer or brand of this product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Sku" class="form-label fw-semibold">SKU <span class="text-danger">*</span></label>
                                            <input asp-for="Sku" class="form-control" required maxlength="50" />
                                            <span asp-validation-for="Sku" class="text-danger small"></span>
                                            <div class="form-text">Stock Keeping Unit - unique identifier for this product</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="ShortDescription" class="form-label fw-semibold">Short Description <span class="text-danger">*</span></label>
                                            <input asp-for="ShortDescription" class="form-control" required maxlength="1000" />
                                            <div class="d-flex justify-content-between">
                                                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                                                <small class="text-muted" id="shortDescCounter">0/160</small>
                                            </div>
                                            <div class="form-text">Brief summary shown in product listings (max 1000 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="Description" class="form-label fw-semibold">Full Description <span class="text-danger">*</span></label>
                                            <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
                                            <span asp-validation-for="Description" class="text-danger small"></span>
                                            <div class="form-text">Detailed product description shown on the product page</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pricing Tab -->
                            <div class="tab-pane fade" id="pricing" role="tabpanel" aria-labelledby="pricing-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="RegularPrice" class="form-label fw-semibold">Regular Price <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="RegularPrice" class="form-control" type="number" step="0.01" min="0" required />
                                            </div>
                                            <span asp-validation-for="RegularPrice" class="text-danger small"></span>
                                            <div class="form-text">The normal, non-discounted price of the product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountPrice" class="form-label fw-semibold">Discount Price</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                                                <button type="button" id="calculateDiscountBtn" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#discountCalculatorModal">
                                                    <i class="bi bi-calculator"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                                            <div class="form-text">Leave empty if no discount is applied</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountStartDate" class="form-label fw-semibold">Discount Start Date</label>
                                            <input asp-for="DiscountStartDate" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="DiscountStartDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period begins</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountEndDate" class="form-label fw-semibold">Discount End Date</label>
                                            <input asp-for="DiscountEndDate" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="DiscountEndDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period ends</div>
                                        </div>
                                    </div>

                                    @if (Model.RegularPrice > 0 && Model.DiscountPrice > 0)
                                    {
                                        <div class="col-12">
                                            <div class="alert alert-info py-3">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                    <div>
                                                        <h6 class="mb-1">Discount Summary</h6>
                                                        <p class="mb-0">
                                                            Discount amount: <strong>$@(Model.RegularPrice - Model.DiscountPrice)</strong> |
                                                            Discount percentage: <strong>@(Math.Round((1 - Model.DiscountPrice ?? 0 / Model.RegularPrice) * 100, 2))%</strong>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Inventory Tab -->
                            <div class="tab-pane fade" id="inventory" role="tabpanel" aria-labelledby="inventory-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Quantity" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                                            <input asp-for="Quantity" class="form-control" type="number" min="0" required />
                                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                                            <div class="form-text">Current inventory level</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Stock Status</label>
                                            <div class="form-text mb-2">Automatically calculated based on quantity</div>
                                            <div class="d-flex align-items-center">
                                                @if (Model.Quantity > 0)
                                                {
                                                    <span class="badge bg-success me-2 px-3 py-2">In Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger me-2 px-3 py-2">Out of Stock</span>
                                                }
                                                <span class="text-muted small">Based on current quantity</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsActiveInput">Product Active</label>
                                            <div class="form-check form-switch">
                                                <input asp-for="IsActive" class="form-check-input" id="IsActiveInput" />
                                                <label class="form-check-label" for="IsActiveInput">
                                                    @(Model.IsActive ? "Product is visible on the store" : "Product is hidden from customers")
                                                </label>
                                            </div>
                                            <div class="form-text">Toggle to show or hide the product on the store</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsFeaturedInput">Featured Product</label>
                                            <div class="form-check form-switch">
                                                <input asp-for="IsFeatured" class="form-check-input" id="IsFeaturedInput" />
                                                <label class="form-check-label" for="IsFeaturedInput">
                                                    @(Model.IsFeatured ? "Product appears in featured sections" : "Product does not appear in featured sections")
                                                </label>
                                            </div>
                                            <div class="form-text">Featured products appear in special sections on the homepage and category pages</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-warning py-3 mt-3">
                                            <div class="d-flex">
                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Low Stock Warning</h6>
                                                    <p class="mb-0">Set up low stock notifications in the <a href="#" class="alert-link">Inventory Settings</a> page.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dimensions Tab -->
                            <div class="tab-pane fade" id="dimensions" role="tabpanel" aria-labelledby="dimensions-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Weight" class="form-label fw-semibold">Weight (kg)</label>
                                            <div class="input-group">
                                                <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                                                <span class="input-group-text">kg</span>
                                            </div>
                                            <span asp-validation-for="Weight" class="text-danger small"></span>
                                            <div class="form-text">Product weight used for shipping calculations</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="alert alert-info py-3">
                                            <div class="d-flex">
                                                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Shipping Information</h6>
                                                    <p class="mb-0">Accurate dimensions ensure correct shipping rates and packaging.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Length" class="form-label fw-semibold">Length (cm)</label>
                                            <div class="input-group">
                                                <input asp-for="Length" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Length" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Width" class="form-label fw-semibold">Width (cm)</label>
                                            <div class="input-group">
                                                <input asp-for="Width" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Width" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Height" class="form-label fw-semibold">Height (cm)</label>
                                            <div class="input-group">
                                                <input asp-for="Height" class="form-control" type="number" step="0.1" min="0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Height" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body">
                                                <h6 class="card-title">Calculated Volume</h6>
                                                <p class="card-text" id="volumeCalculation">
                                                    @if (Model.Length > 0 && Model.Width > 0 && Model.Height > 0)
                                                    {
                                                        <span>@(Model.Length * Model.Width * Model.Height) cm³</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Enter dimensions to calculate volume</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Images Tab -->
                            <div class="tab-pane fade" id="images" role="tabpanel" aria-labelledby="images-tab">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="alert alert-warning py-3 mb-4">
                                            <div class="d-flex">
                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Image Requirements</h6>
                                                    <p class="mb-0">Product images should be at least 800x800 pixels and have a white background for best results.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Product Images</label>

                                        @if (ViewBag.Product != null && ViewBag.Product.ProductImages != null && ViewBag.Product.ProductImages.Count > 0)
                                        {
                                            <div class="row g-3 mb-4">
                                                @foreach (var image in ViewBag.Product.ProductImages)
                                                {
                                                    <div class="col-md-4 col-sm-6">
                                                        <div class="card h-100">
                                                            <div class="card-img-top position-relative" style="height: 200px; overflow: hidden;">
                                                                <img src="@image.ImageUrl" class="img-fluid" style="object-fit: contain; width: 100%; height: 100%;" alt="Product image" />
                                                            </div>
                                                            <div class="card-body">
                                                                <div class="d-flex justify-content-between">
                                                                    <a href="@image.ImageUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                                        <i class="bi bi-eye"></i> View
                                                                    </a>
                                                                    <div>
                                                                        <a asp-action="EditImage" asp-route-id="@image.Id" class="btn btn-sm btn-outline-primary me-1">
                                                                            <i class="bi bi-pencil"></i> Edit
                                                                        </a>
                                                                        <a asp-action="DeleteImage" asp-route-id="@image.Id" class="btn btn-sm btn-outline-danger"
                                                                           onclick="return confirm('Are you sure you want to delete this image?');">
                                                                            <i class="bi bi-trash"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-5 bg-light rounded mb-4">
                                                <i class="bi bi-image fs-1 text-muted"></i>
                                                <p class="mt-3 text-muted">No images uploaded yet</p>
                                            </div>
                                        }

                                        <div class="mt-3">
                                            <a asp-action="UploadImage" asp-route-productId="@Model.Id" class="btn btn-primary">
                                                <i class="bi bi-cloud-upload me-1"></i> Upload New Image
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @* Category Tab *@
                            <!-- Categories Tab -->
                            <!-- Categories Tab -->
                            <div class="tab-pane fade" id="categories" role="tabpanel" aria-labelledby="categories-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Add Category</label>
                                            <div class="input-group">
                                                <select id="categorySelect" class="form-select">
                                                    <option value="">-- Select Category --</option>
                                                    @if (ViewData["AllCategories"] != null)
                                                    {
                                                        foreach (var category in (List<Category>)ViewData["AllCategories"])
                                                        {
                                                            <option value="@category.Name">@category.Name</option>
                                                        }
                                                    }
                                                </select>
                                                <button type="button" id="addCategoryBtn" class="btn btn-primary">
                                                    <i class="bi bi-plus"></i> Add
                                                </button>
                                            </div>
                                            <div class="form-text">Select a category to add to this product</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="card border-0 bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title">Selected Categories</h6>
                                                <div id="selectedCategoriesContainer" class="row g-2">
                                                    @if (Model.Categories != null)
                                                    {
                                                        foreach (var category in Model.Categories)
                                                        {
                                                            <div class="col-auto" data-category-id="@category">
                                                                <div class="badge bg-primary d-flex align-items-center">
                                                                    @category
                                                                    <button type="button" class="btn btn-sm btn-link text-white p-0 ms-2 remove-category" data-category-id="@category">
                                                                        <i class="bi bi-x"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                @if (Model.Categories == null || Model.Categories.Count == 0)
                                                {
                                                    <p id="noCategoriesMessage" class="text-muted mt-2">No categories selected</p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                                <script>
                                                                    document.addEventListener('DOMContentLoaded', function() {
                                    const categorySelect = document.getElementById('categorySelect');
                                    const addCategoryBtn = document.getElementById('addCategoryBtn');
                                    const selectedCategoriesContainer = document.getElementById('selectedCategoriesContainer');
                                    const noCategoriesMessage = document.getElementById('noCategoriesMessage');

                                    // Add category functionality
                                    addCategoryBtn.addEventListener('click', function() {
                                        const selectedCategoryId = categorySelect.value;
                                        const selectedCategoryName = categorySelect.options[categorySelect.selectedIndex].text;

                                        if (selectedCategoryId && !document.querySelector(`[data-category-id="${selectedCategoryId}"]`)) {
                                            // Create category badge with removal functionality
                                            const categoryBadge = document.createElement('div');
                                            categoryBadge.className = 'col-auto';
                                            categoryBadge.dataset.categoryId = selectedCategoryId;
                                            categoryBadge.innerHTML = `
                                                <div class="badge bg-primary d-flex align-items-center">
                                                     ${selectedCategoryName} <i class="bi bi-x"></i>
                                                    <button type="button" class="btn btn-sm btn-link text-white p-0 ms-2 remove-category" data-category-id="${selectedCategoryId}">
                                                    </button>
                                                </div>
                                            `;

                                            selectedCategoriesContainer.appendChild(categoryBadge);

                                            // Hide no categories message
                                            if (noCategoriesMessage) {
                                                noCategoriesMessage.style.display = 'none';
                                            }

                                            // Reset dropdown
                                            categorySelect.value = '';
                                        }
                                    });

                                    // Remove category functionality with improved event delegation
                                    selectedCategoriesContainer.addEventListener('click', function(event) {
                                        const removeBtn = event.target.closest('.remove-category');
                                        if (removeBtn) {
                                            const categoryBadge = removeBtn.closest('.col-auto');
                                            categoryBadge.remove();

                                            // Show no categories message if no categories remain
                                            if (selectedCategoriesContainer.children.length === 0 && noCategoriesMessage) {
                                                noCategoriesMessage.style.display = 'block';
                                            }
                                        }
                                    });

                                    // Modify form submission to include selected categories
                                    document.getElementById('formulario').addEventListener('submit', function(event) {
                                        // Remove any existing category hidden inputs to prevent duplicates
                                        this.querySelectorAll('input[name^="Categories"]').forEach(input => input.remove());

                                        // Create hidden inputs for each selected category
                                        const selectedCategories = selectedCategoriesContainer.querySelectorAll('[data-category-id]');
                                        // Add new hidden inputs for current categories
                                        selectedCategories.forEach((categoryElement, index) => {
                                            const hiddenInput = document.createElement('input');
                                            hiddenInput.type = 'hidden';
                                            hiddenInput.name = `Categories[${index}].Id`;
                                            hiddenInput.value = categoryElement.dataset.categoryId;
                                            this.appendChild(hiddenInput);
                                        });
                                    });
                                });
                                </script>

                            <!-- Metadata Tab -->
                            <div class="tab-pane fade" id="metadata" role="tabpanel" aria-labelledby="metadata-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="CreatedAt" class="form-label fw-semibold">Created At</label>
                                            <input asp-for="CreatedAt" class="form-control bg-light" readonly />
                                            <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="CreatedBy" class="form-label fw-semibold">Created By</label>
                                            <input asp-for="CreatedBy" class="form-control bg-light" readonly />
                                            <span asp-validation-for="CreatedBy" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="UpdatedAt" class="form-label fw-semibold">Last Updated At</label>
                                            <input asp-for="UpdatedAt" class="form-control bg-light" readonly />
                                            <span asp-validation-for="UpdatedAt" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="UpdatedBy" class="form-label fw-semibold">Last Updated By</label>
                                            <input asp-for="UpdatedBy" class="form-control bg-light" readonly />
                                            <span asp-validation-for="UpdatedBy" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="card bg-light border-0">
                                            <div class="card-body">
                                                <h6 class="card-title">Audit Trail</h6>
                                                <p class="card-text small mb-0">
                                                    <i class="bi bi-clock-history me-1"></i> View the complete <a href="#" class="text-decoration-none">edit history</a> for this product.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                            <div>
                                <a asp-action="Preview" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary me-2">
                                    <i class="bi bi-eye me-1"></i> Preview
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="helpModalLabel">Product Editing Help</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>When editing products, please follow these guidelines:</p>
                <ul class="mb-0">
                    <li>Fill in all required fields marked with <span class="text-danger">*</span></li>
                    <li>Use high-quality images with white backgrounds</li>
                    <li>Write detailed descriptions to improve SEO</li>
                    <li>Set accurate dimensions for shipping calculations</li>
                    <li>Use proper pricing and discount dates</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>

<!-- Discount Calculator Modal -->
<div class="modal fade" id="discountCalculatorModal" tabindex="-1" aria-labelledby="discountCalculatorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="discountCalculatorModalLabel">Discount Calculator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="regularPriceCalc" class="form-label">Regular Price ($)</label>
                    <input type="number" class="form-control" id="regularPriceCalc" min="0" step="0.01">
                </div>
                <div class="mb-3">
                    <label for="discountPercentage" class="form-label">Discount Percentage (%)</label>
                    <input type="number" class="form-control" id="discountPercentage" min="0" max="100" step="1">
                </div>
                <div class="alert alert-info" id="calculatedPriceResult">
                    Enter values above to calculate the discounted price
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="applyDiscountBtn" data-bs-dismiss="modal">Apply Discount</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()

                            // Find the first invalid field and switch to its tab
                            const invalidField = form.querySelector(':invalid');
                            if (invalidField) {
                                const tabId = invalidField.closest('.tab-pane').id;
                                const tab = document.querySelector(`[data-bs-target="#${tabId}"]`);
                                if (tab) {
                                    bootstrap.Tab.getOrCreateInstance(tab).show();
                                    invalidField.focus();
                                }
                            }
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Generate slug from product name
        document.getElementById('Name')?.addEventListener('blur', function() {
            const nameField = this;
            const slugField = document.getElementById('Slug');

            // Only generate slug if the slug field is empty or hasn't been manually edited
            if (slugField && (!slugField.value || slugField.dataset.autoGenerated === 'true')) {
                const slug = nameField.value
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .trim();

                slugField.value = slug;
                slugField.dataset.autoGenerated = 'true';
            }
        });

        // Generate slug button
        document.getElementById('generateSlugBtn')?.addEventListener('click', function() {
            const nameField = document.getElementById('Name');
            const slugField = document.getElementById('Slug');

            if (nameField && slugField) {
                const slug = nameField.value
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .trim();

                slugField.value = slug;
                slugField.dataset.autoGenerated = 'true';
            }
        });

        // Mark slug as manually edited
        document.getElementById('Slug')?.addEventListener('input', function() {
            this.dataset.autoGenerated = 'false';
        });

        // Short description character counter
        document.getElementById('ShortDescription')?.addEventListener('input', function() {
            const counter = document.getElementById('shortDescCounter');
            if (counter) {
                counter.textContent = `${this.value.length}/160`;
                if (this.value.length > 160) {
                    counter.classList.add('text-danger');
                } else {
                    counter.classList.remove('text-danger');
                }
            }
        });

        // Initialize short description counter
        const shortDesc = document.getElementById('ShortDescription');
        if (shortDesc) {
            const counter = document.getElementById('shortDescCounter');
            if (counter) {
                counter.textContent = `${shortDesc.value.length}/160`;
            }
        }

        // Calculate volume when dimensions change
        const lengthInput = document.getElementById('Length');
        const widthInput = document.getElementById('Width');
        const heightInput = document.getElementById('Height');
        const volumeCalculation = document.getElementById('volumeCalculation');

        function updateVolume() {
            if (lengthInput && widthInput && heightInput && volumeCalculation) {
                const length = parseFloat(lengthInput.value) || 0;
                const width = parseFloat(widthInput.value) || 0;
                const height = parseFloat(heightInput.value) || 0;

                if (length > 0 && width > 0 && height > 0) {
                    const volume = length * width * height;
                    volumeCalculation.textContent = `${volume.toFixed(2)} cm³`;
                } else {
                    volumeCalculation.textContent = 'Enter dimensions to calculate volume';
                }
            }
        }

        lengthInput?.addEventListener('input', updateVolume);
        widthInput?.addEventListener('input', updateVolume);
        heightInput?.addEventListener('input', updateVolume);

        // Discount calculator
        const regularPriceCalc = document.getElementById('regularPriceCalc');
        const discountPercentage = document.getElementById('discountPercentage');
        const calculatedPriceResult = document.getElementById('calculatedPriceResult');
        const applyDiscountBtn = document.getElementById('applyDiscountBtn');
        const discountPriceInput = document.getElementById('DiscountPrice');
        const regularPriceInput = document.getElementById('RegularPrice');

        function calculateDiscountedPrice() {
            if (regularPriceCalc && discountPercentage && calculatedPriceResult) {
                const regularPrice = parseFloat(regularPriceCalc.value) || 0;
                const percentage = parseFloat(discountPercentage.value) || 0;

                if (regularPrice > 0 && percentage > 0) {
                    const discountAmount = regularPrice * (percentage / 100);
                    const discountedPrice = regularPrice - discountAmount;

                    calculatedPriceResult.innerHTML = `
                        <strong>Regular Price:</strong> $${regularPrice.toFixed(2)}<br>
                        <strong>Discount:</strong> ${percentage}% ($${discountAmount.toFixed(2)})<br>
                        <strong>Final Price:</strong> $${discountedPrice.toFixed(2)}
                    `;

                    return discountedPrice;
                } else {
                    calculatedPriceResult.textContent = 'Enter valid values to calculate the discounted price';
                    return 0;
                }
            }
            return 0;
        }

        regularPriceCalc?.addEventListener('input', calculateDiscountedPrice);
        discountPercentage?.addEventListener('input', calculateDiscountedPrice);

        // Apply calculated discount to the form
        applyDiscountBtn?.addEventListener('click', function() {
            const discountedPrice = calculateDiscountedPrice();
            if (discountedPrice > 0 && discountPriceInput) {
                discountPriceInput.value = discountedPrice.toFixed(2);
            }
        });

        // Initialize discount calculator with current values
        document.getElementById('discountCalculatorModal')?.addEventListener('show.bs.modal', function () {
            if (regularPriceInput && regularPriceCalc) {
                regularPriceCalc.value = regularPriceInput.value;
            }

            if (regularPriceInput && discountPriceInput && discountPercentage) {
                const regularPrice = parseFloat(regularPriceInput.value) || 0;
                const discountPrice = parseFloat(discountPriceInput.value) || 0;

                if (regularPrice > 0 && discountPrice > 0 && discountPrice < regularPrice) {
                    const percentage = ((regularPrice - discountPrice) / regularPrice) * 100;
                    discountPercentage.value = percentage.toFixed(0);
                    calculateDiscountedPrice();
                }
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}