@model ECommerce.Beganit.AdminPanel.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
    var commonAttributes = new List<string> { "Color", "Size", "Material", "Weight", "Dimensions", "Pattern", "Warranty", "Capacity" };
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="card border-0 shadow-sm mb-4 bg-gradient-primary">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white p-3 me-3 shadow-sm">
                    <i class="bi bi-box-seam text-primary fs-3"></i>
                </div>
                <div class="text-white">
                    <h1 class="h3 mb-0">Create New Product</h1>
                    <p class="mb-0 opacity-75">Add a new product to your store with all details</p>
                </div>
                <div class="ms-auto">
                    <a asp-action="Index" class="btn btn-light me-2">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#helpModal">
                        <i class="bi bi-question-circle me-1"></i> Help
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <ul class="nav nav-tabs card-header-tabs" id="productTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">
                                <i class="bi bi-info-circle me-1"></i> Basic Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pricing-tab" data-bs-toggle="tab" data-bs-target="#pricing" type="button" role="tab" aria-controls="pricing" aria-selected="false">
                                <i class="bi bi-currency-dollar me-1"></i> Pricing
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory" type="button" role="tab" aria-controls="inventory" aria-selected="false">
                                <i class="bi bi-box-seam me-1"></i> Inventory
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="dimensions-tab" data-bs-toggle="tab" data-bs-target="#dimensions" type="button" role="tab" aria-controls="dimensions" aria-selected="false">
                                <i class="bi bi-rulers me-1"></i> Dimensions
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="attributes-tab" data-bs-toggle="tab" data-bs-target="#attributes" type="button" role="tab" aria-controls="attributes" aria-selected="false">
                                <i class="bi bi-list-check me-1"></i> Attributes
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="images-tab" data-bs-toggle="tab" data-bs-target="#images" type="button" role="tab" aria-controls="images" aria-selected="false">
                                <i class="bi bi-images me-1"></i> Images
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories" aria-selected="false">
                                <i class="bi bi-tags me-1"></i> Categories
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <form id="productForm" asp-action="CreateProduct" method="post" class="needs-validation" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-4" role="alert"></div>

                        <div class="tab-content" id="productTabsContent">
                            <!-- Basic Info Tab -->
                            <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-pencil"></i>
                                                </span>
                                                <input asp-for="Name" class="form-control" required maxlength="255" placeholder="Enter product name" />
                                            </div>
                                            <span asp-validation-for="Name" class="text-danger small"></span>
                                            <div class="form-text">Enter a descriptive name for your product (max 255 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Slug" class="form-label fw-semibold">URL Slug <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">/product/</span>
                                                <input asp-for="Slug" class="form-control" required pattern="[a-z0-9-]+" placeholder="product-url-slug" />
                                                <button type="button" id="generateSlugBtn" class="btn btn-outline-secondary">
                                                    <i class="bi bi-magic"></i> Generate
                                                </button>
                                            </div>
                                            <span asp-validation-for="Slug" class="text-danger small"></span>
                                            <div class="form-text">Used in the URL (e.g., example.com/product/your-slug). Use only lowercase letters, numbers, and hyphens.</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-briefcase"></i>
                                                </span>
                                                <select asp-for="BrandId" class="form-select" required>
                                                    <option value="">-- Select Brand --</option>
                                                    @if (ViewBag.Brands != null)
                                                    {
                                                        foreach (var brand in ViewBag.Brands)
                                                        {
                                                            <option value="@brand.Id">@brand.Name</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                                            <div class="form-text">Select the manufacturer or brand of this product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Sku" class="form-label fw-semibold">SKU <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-upc-scan"></i>
                                                </span>
                                                <input asp-for="Sku" class="form-control" required maxlength="50" placeholder="SKU-12345" />
                                            </div>
                                            <span asp-validation-for="Sku" class="text-danger small"></span>
                                            <div class="form-text">Stock Keeping Unit - unique identifier for this product</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="ShortDescription" class="form-label fw-semibold">Short Description <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-text-paragraph"></i>
                                                </span>
                                                <input asp-for="ShortDescription" class="form-control" required maxlength="1000" placeholder="Brief product description" />
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                                                <small class="text-muted" id="shortDescCounter">0/160</small>
                                            </div>
                                            <div class="form-text">Brief summary shown in product listings (max 1000 characters)</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="mb-3">
                                            <label asp-for="Description" class="form-label fw-semibold">Full Description <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-file-text"></i>
                                                </span>
                                                <textarea asp-for="Description" class="form-control" rows="5" required placeholder="Detailed product description"></textarea>
                                            </div>
                                            <span asp-validation-for="Description" class="text-danger small"></span>
                                            <div class="form-text">Detailed product description shown on the product page</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pricing Tab -->
                            <div class="tab-pane fade" id="pricing" role="tabpanel" aria-labelledby="pricing-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="RegularPrice" class="form-label fw-semibold">Regular Price <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="RegularPrice" class="form-control" type="number" step="0.01" min="0" required placeholder="0.00" />
                                            </div>
                                            <span asp-validation-for="RegularPrice" class="text-danger small"></span>
                                            <div class="form-text">The normal, non-discounted price of the product</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountPrice" class="form-label fw-semibold">Discount Price</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                                <button type="button" id="calculateDiscountBtn" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#discountCalculatorModal">
                                                    <i class="bi bi-calculator"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                                            <div class="form-text">Leave empty if no discount is applied</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountStartDate" class="form-label fw-semibold">Discount Start Date</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-calendar-event"></i>
                                                </span>
                                                <input asp-for="DiscountStartDate" class="form-control" type="datetime-local" />
                                            </div>
                                            <span asp-validation-for="DiscountStartDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period begins</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountEndDate" class="form-label fw-semibold">Discount End Date</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-calendar-event"></i>
                                                </span>
                                                <input asp-for="DiscountEndDate" class="form-control" type="datetime-local" />
                                            </div>
                                            <span asp-validation-for="DiscountEndDate" class="text-danger small"></span>
                                            <div class="form-text">When the discount period ends</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-info py-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Pricing Tips</h6>
                                                    <p class="mb-0">
                                                        Set competitive prices and use discounts strategically to attract customers.
                                                        Limited-time offers can create urgency and boost sales.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Inventory Tab -->
                            <div class="tab-pane fade" id="inventory" role="tabpanel" aria-labelledby="inventory-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Quantity" class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-boxes"></i>
                                                </span>
                                                <input asp-for="Quantity" class="form-control" type="number" min="0" required placeholder="0" />
                                            </div>
                                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                                            <div class="form-text">Current inventory level</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Stock Status</label>
                                            <div class="form-text mb-2">Will be automatically calculated based on quantity</div>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-secondary me-2 px-3 py-2">Not Set</span>
                                                <span class="text-muted small">Will be determined by stock quantity</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsActiveInput">Product Active</label>
                                            <div class="form-check form-switch form-switch-lg">
                                                <input asp-for="IsActive" class="form-check-input" id="IsActiveInput" checked />
                                                <label class="form-check-label" for="IsActiveInput">
                                                    Product will be visible on the store
                                                </label>
                                            </div>
                                            <div class="form-text">Toggle to show or hide the product on the store</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold" for="IsFeaturedInput">Featured Product</label>
                                            <div class="form-check form-switch form-switch-lg">
                                                <input asp-for="IsFeatured" class="form-check-input" id="IsFeaturedInput" />
                                                <label class="form-check-label" for="IsFeaturedInput">
                                                    Product will appear in featured sections
                                                </label>
                                            </div>
                                            <div class="form-text">Featured products appear in special sections on the homepage and category pages</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-warning py-3 mt-3">
                                            <div class="d-flex">
                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Inventory Management</h6>
                                                    <p class="mb-0">Keep your inventory updated to avoid overselling. You can set up low stock notifications in the <a href="#" class="alert-link">Inventory Settings</a> page.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dimensions Tab -->
                            <div class="tab-pane fade" id="dimensions" role="tabpanel" aria-labelledby="dimensions-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Weight" class="form-label fw-semibold">Weight (kg)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-speedometer2"></i>
                                                </span>
                                                <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                                <span class="input-group-text">kg</span>
                                            </div>
                                            <span asp-validation-for="Weight" class="text-danger small"></span>
                                            <div class="form-text">Product weight used for shipping calculations</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="alert alert-info py-3">
                                            <div class="d-flex">
                                                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Shipping Information</h6>
                                                    <p class="mb-0">Accurate dimensions ensure correct shipping rates and packaging.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Length" class="form-label fw-semibold">Length (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Length" class="form-control" type="number" step="0.1" min="0" placeholder="0.0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Length" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Width" class="form-label fw-semibold">Width (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Width" class="form-control" type="number" step="0.1" min="0" placeholder="0.0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Width" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="Height" class="form-label fw-semibold">Height (cm)</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </span>
                                                <input asp-for="Height" class="form-control" type="number" step="0.1" min="0" placeholder="0.0" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Height" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="card bg-light border-0 shadow-sm">
                                            <div class="card-body">
                                                <h6 class="card-title d-flex align-items-center">
                                                    <i class="bi bi-calculator me-2 text-primary"></i>
                                                    Calculated Volume
                                                </h6>
                                                <p class="card-text" id="volumeCalculation">
                                                    Enter dimensions to calculate volume
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attributes Tab -->
                            <div class="tab-pane fade" id="attributes" role="tabpanel" aria-labelledby="attributes-tab">
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <div class="alert alert-info d-flex align-items-center">
                                            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                            <div>
                                                <h6 class="mb-1">Product Attributes</h6>
                                                <p class="mb-0">Attributes help customers find and filter products. Add attributes like color, size, material, etc.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-5">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-plus-circle me-2 text-primary"></i>Add Attribute
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-3">
                                                    <label for="attributeNameInput" class="form-label">Attribute Name</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light">
                                                            <i class="bi bi-tag"></i>
                                                        </span>
                                                        <input type="text" id="attributeNameInput" class="form-control" placeholder="e.g. Color, Size, Material" list="commonAttributesList" />
                                                        <datalist id="commonAttributesList">
                                                            @foreach (var attr in commonAttributes)
                                                            {
                                                                <option value="@attr">@attr</option>
                                                            }
                                                        </datalist>
                                                    </div>
                                                    <div class="form-text">Choose from common attributes or enter a custom one</div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="attributeValueInput" class="form-label">Attribute Value</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light">
                                                            <i class="bi bi-input-cursor-text"></i>
                                                        </span>
                                                        <input type="text" id="attributeValueInput" class="form-control" placeholder="e.g. Red, XL, Cotton" />
                                                    </div>
                                                    <div class="form-text">Enter the specific value for this attribute</div>
                                                </div>

                                                <div id="commonValuesContainer" class="d-none mb-3">
                                                    <label class="form-label">Common Values</label>
                                                    <div id="commonValuesList" class="d-flex flex-wrap gap-1">
                                                        <!-- Populated dynamically by JavaScript -->
                                                    </div>
                                                </div>

                                                <div class="d-grid mt-4">
                                                    <button type="button" id="addAttributeBtn" class="btn btn-primary">
                                                        <i class="bi bi-plus-lg me-1"></i> Add Attribute
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-list-check me-2 text-primary"></i>Product Attributes
                                                </h5>
                                                <span class="badge bg-primary rounded-pill" id="attributeCount">0</span>
                                            </div>
                                            <div class="card-body">
                                                <div id="attributesContainer">
                                                    <div id="noAttributesMessage" class="text-center py-5">
                                                        <div class="mb-3">
                                                            <i class="bi bi-tags text-muted fs-1"></i>
                                                        </div>
                                                        <h6 class="text-muted">No attributes added yet</h6>
                                                        <p class="text-muted mb-0">Add attributes to help customers find your product</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer bg-white p-3 border-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="text-muted small">
                                                        <i class="bi bi-info-circle me-1"></i>
                                                        Attributes help with product filtering and search
                                                    </span>
                                                    <button type="button" id="clearAttributesBtn" class="btn btn-sm btn-outline-danger" disabled>
                                                        <i class="bi bi-trash me-  disabled>
                                                            <i class="bi bi-trash me-1"></i> Clear All
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Images Tab -->
                            <div class="tab-pane fade" id="images" role="tabpanel" aria-labelledby="images-tab">
                                <div class="row g-4">
                                    <div class="col-12">
                                        <div class="alert alert-warning py-3 mb-4">
                                            <div class="d-flex">
                                                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                                <div>
                                                    <h6 class="mb-1">Image Requirements</h6>
                                                    <p class="mb-0">Product images should be at least 800x800 pixels and have a white background for best results.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-cloud-upload me-2 text-primary"></i>Upload Images
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-4">
                                                    <div class="dropzone-container border-2 border-dashed rounded-3 p-4 text-center bg-light position-relative" id="imageDropzone">
                                                        <input type="file" id="productImages" name="productImages" class="position-absolute inset-0 w-100 h-100 opacity-0 z-50 cursor-pointer" multiple accept="image/*" style="cursor: pointer;" />
                                                        <div class="dropzone-content py-4">
                                                            <i class="bi bi-cloud-arrow-up text-primary display-4 mb-3"></i>
                                                            <h5>Drag and drop images here</h5>
                                                            <p class="text-muted mb-2">or click to browse files</p>
                                                            <p class="small text-muted mb-0">Supported formats: JPG, PNG, GIF (Max 5MB each)</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="compressImages" checked>
                                                    <label class="form-check-label" for="compressImages">
                                                        Automatically optimize images for web
                                                    </label>
                                                    <div class="form-text">Reduces file size without significant quality loss</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-5">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-images me-2 text-primary"></i>Selected Images
                                                </h5>
                                                <span class="badge bg-primary rounded-pill" id="imageCount">0</span>
                                            </div>
                                            <div class="card-body">
                                                <div id="selectedImagesContainer" class="mb-3">
                                                    <div id="noImagesMessage" class="text-center py-5">
                                                        <div class="mb-3">
                                                            <i class="bi bi-image text-muted fs-1"></i>
                                                        </div>
                                                        <h6 class="text-muted">No images selected yet</h6>
                                                        <p class="text-muted mb-0">Upload at least one image for your product</p>
                                                    </div>
                                                    <div id="imagePreviewsContainer" class="row g-3" style="display: none;">
                                                        <!-- Image previews will be added here dynamically -->
                                                    </div>
                                                </div>

                                                <div class="alert alert-info small">
                                                    <i class="bi bi-info-circle-fill me-2"></i>
                                                    The first image will be set as the primary product image
                                                </div>
                                            </div>
                                            <div class="card-footer bg-white p-3 border-0">
                                                <button type="button" id="clearImagesBtn" class="btn btn-sm btn-outline-danger w-100" disabled>
                                                    <i class="bi bi-trash me-1"></i> Clear All Images
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Categories Tab -->
                            <div class="tab-pane fade" id="categories" role="tabpanel" aria-labelledby="categories-tab">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-folder-plus me-2 text-primary"></i>Add Categories
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="mb-3">
                                                    <label for="categorySelect" class="form-label">Select Category</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light">
                                                            <i class="bi bi-folder2"></i>
                                                        </span>
                                                        <select id="categorySelect" class="form-select">
                                                            <option value="">-- Select Category --</option>
                                                            @if (ViewData["AllCategories"] != null)
                                                            {
                                                                foreach (var category in (List<Category>)ViewData["AllCategories"])
                                                                {
                                                                    <option value="@category.Name">@category.Name</option>
                                                                }
                                                            }
                                                        </select>
                                                        <button type="button" id="addCategoryBtn" class="btn btn-primary">
                                                            <i class="bi bi-plus-lg"></i> Add
                                                        </button>
                                                    </div>
                                                    <div class="form-text">Select a category to add to this product</div>
                                                </div>

                                                <div class="alert alert-info mt-4">
                                                    <div class="d-flex">
                                                        <i class="bi bi-info-circle-fill me-2"></i>
                                                        <div>
                                                            <p class="mb-0">Products can belong to multiple categories. Add all relevant categories to improve discoverability.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-header bg-light py-3">
                                                <h5 class="card-title mb-0">
                                                    <i class="bi bi-tags me-2 text-primary"></i>Selected Categories
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <div id="selectedCategoriesContainer" class="mb-3">
                                                    <p id="noCategoriesMessage" class="text-muted">No categories selected yet</p>
                                                </div>

                                                <div class="category-stats mt-4">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="text-muted">Total categories:</span>
                                                        <span class="badge bg-secondary" id="categoryCount">0</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                            <div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i> Create Product
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="helpModalLabel">
                    <i class="bi bi-question-circle me-2"></i>
                    Product Creation Help
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>When creating products, please follow these guidelines:</p>
                <ul class="mb-0">
                    <li class="mb-2">Fill in all required fields marked with <span class="text-danger">*</span></li>
                    <li class="mb-2">Upload high-quality images with white backgrounds</li>
                    <li class="mb-2">Write detailed descriptions to improve SEO</li>
                    <li class="mb-2">Set accurate dimensions for shipping calculations</li>
                    <li class="mb-2">Add relevant attributes to improve product filtering</li>
                    <li class="mb-2">Assign appropriate categories to improve discoverability</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>

<!-- Discount Calculator Modal -->
<div class="modal fade" id="discountCalculatorModal" tabindex="-1" aria-labelledby="discountCalculatorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="discountCalculatorModalLabel">
                    <i class="bi bi-calculator me-2"></i>
                    Discount Calculator
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="regularPriceCalc" class="form-label">Regular Price ($)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" id="regularPriceCalc" min="0" step="0.01">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="discountPercentage" class="form-label">Discount Percentage (%)</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="discountPercentage" min="0" max="100" step="1">
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="alert alert-info" id="calculatedPriceResult">
                    Enter values above to calculate the discounted price
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="applyDiscountBtn" data-bs-dismiss="modal">Apply Discount</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
