@section Scripts {
    <script>
        // Common attribute values mapping
        const attributeValuesMap = {
            'Color': ['Red', 'Blue', 'Green', 'Black', 'White', 'Yellow', 'Purple', 'Orange', 'Pink', 'Gray', 'Brown'],
            'Size': ['XS', 'S', 'M', 'L', 'XL', 'XXL', '2XL', '3XL', '4XL', '5XL'],
            'Material': ['Cotton', 'Polyester', 'Leather', 'Wool', 'Silk', 'Linen', 'Denim', 'Nylon', 'Spandex'],
            'Weight': ['Light', 'Medium', 'Heavy'],
            'Dimensions': ['Small', 'Medium', 'Large'],
            'Pattern': ['Solid', 'Striped', 'Plaid', 'Floral', 'Polka Dot', 'Checkered', 'Geometric'],
            'Warranty': ['1 Year', '2 Years', '3 Years', '5 Years', 'Lifetime'],
            'Capacity': ['Small', 'Medium', 'Large', 'Extra Large']
        };

        // Bootstrap form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()

                            // Find the first invalid field and switch to its tab
                            const invalidField = form.querySelector(':invalid');
                            if (invalidField) {
                                const tabId = invalidField.closest('.tab-pane').id;
                                const tab = document.querySelector(`[data-bs-target="#${tabId}"]`);
                                if (tab) {
                                    bootstrap.Tab.getOrCreateInstance(tab).show();
                                    invalidField.focus();
                                }
                            }
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Generate slug from product name
        document.getElementById('Name')?.addEventListener('blur', function() {
            const nameField = this;
            const slugField = document.getElementById('Slug');

            // Only generate slug if the slug field is empty or hasn't been manually edited
            if (slugField && (!slugField.value || slugField.dataset.autoGenerated === 'true')) {
                const slug = nameField.value
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .trim();

                slugField.value = slug;
                slugField.dataset.autoGenerated = 'true';
            }
        });

        // Generate slug button
        document.getElementById('generateSlugBtn')?.addEventListener('click', function() {
            const nameField = document.getElementById('Name');
            const slugField = document.getElementById('Slug');

            if (nameField && slugField) {
                const slug = nameField.value
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, '')
                    .replace(/\s+/g, '-')
                    .replace(/-+/g, '-')
                    .trim();

                slugField.value = slug;
                slugField.dataset.autoGenerated = 'true';
            }
        });

        // Mark slug as manually edited
        document.getElementById('Slug')?.addEventListener('input', function() {
            this.dataset.autoGenerated = 'false';
        });

        // Short description character counter
        document.getElementById('ShortDescription')?.addEventListener('input', function() {
            const counter = document.getElementById('shortDescCounter');
            if (counter) {
                counter.textContent = `${this.value.length}/160`;
                if (this.value.length > 160) {
                    counter.classList.add('text-danger');
                } else {
                    counter.classList.remove('text-danger');
                }
            }
        });

        // Initialize short description counter
        const shortDesc = document.getElementById('ShortDescription');
        if (shortDesc) {
            const counter = document.getElementById('shortDescCounter');
            if (counter) {
                counter.textContent = `${shortDesc.value.length}/160`;
            }
        }

        // Calculate volume when dimensions change
        const lengthInput = document.getElementById('Length');
        const widthInput = document.getElementById('Width');
        const heightInput = document.getElementById('Height');
        const volumeCalculation = document.getElementById('volumeCalculation');

        function updateVolume() {
            if (lengthInput && widthInput && heightInput && volumeCalculation) {
                const length = parseFloat(lengthInput.value) || 0;
                const width = parseFloat(widthInput.value) || 0;
                const height = parseFloat(heightInput.value) || 0;

                if (length > 0 && width > 0 && height > 0) {
                    const volume = length * width * height;
                    volumeCalculation.textContent = `${volume.toFixed(2)} cm³`;
                } else {
                    volumeCalculation.textContent = 'Enter dimensions to calculate volume';
                }
            }
        }

        lengthInput?.addEventListener('input', updateVolume);
        widthInput?.addEventListener('input', updateVolume);
        heightInput?.addEventListener('input', updateVolume);

        // Discount calculator
        const regularPriceCalc = document.getElementById('regularPriceCalc');
        const discountPercentage = document.getElementById('discountPercentage');
        const calculatedPriceResult = document.getElementById('calculatedPriceResult');
        const applyDiscountBtn = document.getElementById('applyDiscountBtn');
        const discountPriceInput = document.getElementById('DiscountPrice');
        const regularPriceInput = document.getElementById('RegularPrice');

        function calculateDiscountedPrice() {
            if (regularPriceCalc && discountPercentage && calculatedPriceResult) {
                const regularPrice = parseFloat(regularPriceCalc.value) || 0;
                const percentage = parseFloat(discountPercentage.value) || 0;

                if (regularPrice > 0 && percentage > 0) {
                    const discountAmount = regularPrice * (percentage / 100);
                    const discountedPrice = regularPrice - discountAmount;

                    calculatedPriceResult.innerHTML = `
                        <strong>Regular Price:</strong> $${regularPrice.toFixed(2)}<br>
                        <strong>Discount:</strong> ${percentage}% ($${discountAmount.toFixed(2)})<br>
                        <strong>Final Price:</strong> $${discountedPrice.toFixed(2)}
                    `;

                    return discountedPrice;
                } else {
                    calculatedPriceResult.textContent = 'Enter valid values to calculate the discounted price';
                    return 0;
                }
            }
            return 0;
        }

        regularPriceCalc?.addEventListener('input', calculateDiscountedPrice);
        discountPercentage?.addEventListener('input', calculateDiscountedPrice);

        // Apply calculated discount to the form
        applyDiscountBtn?.addEventListener('click', function() {
            const discountedPrice = calculateDiscountedPrice();
            if (discountedPrice > 0 && discountPriceInput) {
                discountPriceInput.value = discountedPrice.toFixed(2);
            }
        });

        // Initialize discount calculator with current values
        document.getElementById('discountCalculatorModal')?.addEventListener('show.bs.modal', function () {
            if (regularPriceInput && regularPriceCalc) {
                regularPriceCalc.value = regularPriceInput.value;
            }

            if (regularPriceInput && discountPriceInput && discountPercentage) {
                const regularPrice = parseFloat(regularPriceInput.value) || 0;
                const discountPrice = parseFloat(discountPriceInput.value) || 0;

                if (regularPrice > 0 && discountPrice > 0 && discountPrice < regularPrice) {
                    const percentage = ((regularPrice - discountPrice) / regularPrice) * 100;
                    discountPercentage.value = percentage.toFixed(0);
                    calculateDiscountedPrice();
                }
            }
        });

        // Categories functionality
        document.addEventListener('DOMContentLoaded', function() {
            const categorySelect = document.getElementById('categorySelect');
            const addCategoryBtn = document.getElementById('addCategoryBtn');
            const selectedCategoriesContainer = document.getElementById('selectedCategoriesContainer');
            const noCategoriesMessage = document.getElementById('noCategoriesMessage');
            const categoryCount = document.getElementById('categoryCount');

            // Add category functionality
            addCategoryBtn?.addEventListener('click', function() {
                const selectedCategory = categorySelect.value;
                const selectedCategoryText = categorySelect.options[categorySelect.selectedIndex].text;

                if (!selectedCategory) return;

                // Check if category already exists
                if (document.querySelector(`.category-badge[data-category="${selectedCategory}"]`)) {
                    // Flash the existing category to indicate it's already added
                    const existingBadge = document.querySelector(`.category-badge[data-category="${selectedCategory}"]`);
                    existingBadge.classList.add('bg-warning');
                    setTimeout(() => {
                        existingBadge.classList.remove('bg-warning');
                    }, 1000);
                    return;
                }

                // Create new category badge
                const categoryBadge = document.createElement('div');
                categoryBadge.className = 'category-badge';
                categoryBadge.setAttribute('data-category', selectedCategory);
                categoryBadge.innerHTML = `
                    <span class="badge bg-primary d-flex align-items-center p-2">
                        <i class="bi bi-tag-fill me-1"></i>
                        ${selectedCategoryText}
                        <button type="button" class="btn-close btn-close-white ms-2 remove-category" aria-label="Remove"></button>
                        <input type="hidden" name="Categories" value="${selectedCategory}" />
                    </span>
                `;

                // Add to container
                if (noCategoriesMessage) {
                    noCategoriesMessage.style.display = 'none';
                }

                // If container is empty, create a wrapper div
                if (!selectedCategoriesContainer.querySelector('.d-flex.flex-wrap')) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'd-flex flex-wrap gap-2';
                    selectedCategoriesContainer.appendChild(wrapper);
                    wrapper.appendChild(categoryBadge);
                } else {
                    selectedCategoriesContainer.querySelector('.d-flex.flex-wrap').appendChild(categoryBadge);
                }

                // Update count
                updateCategoryCount();

                // Reset select
                categorySelect.value = '';
            });

            // Remove category with event delegation
            selectedCategoriesContainer?.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-category') || e.target.closest('.remove-category')) {
                    const badge = e.target.closest('.category-badge');
                    badge.classList.add('fade-out');

                    setTimeout(() => {
                        badge.remove();

                        // Show no categories message if empty
                        const badges = selectedCategoriesContainer.querySelectorAll('.category-badge');
                        if (badges.length === 0 && noCategoriesMessage) {
                            noCategoriesMessage.style.display = 'block';
                        }

                        // Update count
                        updateCategoryCount();
                    }, 300);
                }
            });

            // Update category count
            function updateCategoryCount() {
                if (categoryCount) {
                    const count = selectedCategoriesContainer.querySelectorAll('.category-badge').length;
                    categoryCount.textContent = count;
                }
            }

            // Initialize count
            updateCategoryCount();
        });

        // Attributes functionality
        document.addEventListener('DOMContentLoaded', function() {
            const attributeNameInput = document.getElementById('attributeNameInput');
            const attributeValueInput = document.getElementById('attributeValueInput');
            const addAttributeBtn = document.getElementById('addAttributeBtn');
            const attributesContainer = document.getElementById('attributesContainer');
            const noAttributesMessage = document.getElementById('noAttributesMessage');
            const attributeCount = document.getElementById('attributeCount');
            const clearAttributesBtn = document.getElementById('clearAttributesBtn');
            const commonValuesContainer = document.getElementById('commonValuesContainer');
            const commonValuesList = document.getElementById('commonValuesList');

            // Attribute name input change - show common values if available
            attributeNameInput?.addEventListener('input', function() {
                const attributeName = this.value;
                const commonValues = attributeValuesMap[attributeName];

                if (commonValues && commonValues.length > 0) {
                    // Populate common values
                    commonValuesList.innerHTML = '';
                    commonValues.forEach(value => {
                        const valueBtn = document.createElement('button');
                        valueBtn.type = 'button';
                        valueBtn.className = 'btn btn-sm btn-outline-secondary mb-1 me-1';
                        valueBtn.textContent = value;
                        valueBtn.addEventListener('click', function() {
                            attributeValueInput.value = value;
                        });
                        commonValuesList.appendChild(valueBtn);
                    });

                    // Show common values container
                    commonValuesContainer.classList.remove('d-none');
                } else {
                    // Hide common values container
                    commonValuesContainer.classList.add('d-none');
                }
            });

            // Add attribute functionality
            addAttributeBtn?.addEventListener('click', function() {
                const attributeName = attributeNameInput.value.trim();
                const attributeValue = attributeValueInput.value.trim();

                if (!attributeName || !attributeValue) {
                    // Show validation error
                    if (!attributeName) attributeNameInput.classList.add('is-invalid');
                    if (!attributeValue) attributeValueInput.classList.add('is-invalid');
                    return;
                }

                // Remove validation errors
                attributeNameInput.classList.remove('is-invalid');
                attributeValueInput.classList.remove('is-invalid');

                // Check if attribute already exists
                const existingAttributes = document.querySelectorAll('.attribute-name');
                for (let i = 0; i < existingAttributes.length; i++) {
                    if (existingAttributes[i].value.toLowerCase() === attributeName.toLowerCase()) {
                        // Flash the existing attribute to indicate it's already added
                        const existingRow = existingAttributes[i].closest('.attribute-row');
                        existingRow.classList.add('bg-warning', 'bg-opacity-25');
                        setTimeout(() => {
                            existingRow.classList.remove('bg-warning', 'bg-opacity-25');
                        }, 1000);
                        return;
                    }
                }

                // Hide no attributes message
                if (noAttributesMessage) {
                    noAttributesMessage.style.display = 'none';
                }

                // Get current attribute count
                const index = document.querySelectorAll('.attribute-row').length;

                // Create new attribute row
                const attributeRow = document.createElement('div');
                attributeRow.className = 'attribute-row mb-3 p-3 border rounded bg-light position-relative';
                attributeRow.innerHTML = `
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2 remove-attribute" aria-label="Remove"></button>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label small fw-medium">Attribute Name</label>
                            <input type="text" name="Attributes[${index}].AttributeName" class="form-control attribute-name" value="${attributeName}" readonly />
                            <input type="hidden" name="Attributes[${index}].Id" value="0" />
                            <input type="hidden" name="Attributes[${index}].ProductId" value="0" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-medium">Attribute Value</label>
                            <input type="text" name="Attributes[${index}].AttributeValue" class="form-control attribute-value" value="${attributeValue}" />
                        </div>
                    </div>
                `;

                // Add to container
                attributesContainer.appendChild(attributeRow);

                // Update attribute count
                updateAttributeCount();

                // Enable clear button
                clearAttributesBtn.disabled = false;

                // Reset inputs
                attributeNameInput.value = '';
                attributeValueInput.value = '';
                commonValuesContainer.classList.add('d-none');
            });

            // Remove attribute with event delegation
            attributesContainer?.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-attribute') || e.target.closest('.remove-attribute')) {
                    const row = e.target.closest('.attribute-row');

                    // Add fade out animation
                    row.style.opacity = '0';
                    row.style.transform = 'translateY(-10px)';

                    setTimeout(() => {
                        row.remove();

                        // Show no attributes message if no attributes left
                        if (document.querySelectorAll('.attribute-row').length === 0) {
                            if (noAttributesMessage) {
                                noAttributesMessage.style.display = 'block';
                            }

                            // Disable clear button
                            clearAttributesBtn.disabled = true;
                        }

                        // Update attribute indexes
                        updateAttributeIndexes();

                        // Update attribute count
                        updateAttributeCount();
                    }, 300);
                }
            });

            // Clear all attributes
            clearAttributesBtn?.addEventListener('click', function() {
                if (confirm('Are you sure you want to remove all attributes?')) {
                    // Remove all attribute rows
                    const attributeRows = document.querySelectorAll('.attribute-row');
                    attributeRows.forEach(row => {
                        row.remove();
                    });

                    // Show no attributes message
                    if (noAttributesMessage) {
                        noAttributesMessage.style.display = 'block';
                    }

                    // Disable clear button
                    this.disabled = true;

                    // Update attribute count
                    updateAttributeCount();
                }
            });

            // Update attribute indexes
            function updateAttributeIndexes() {
                const attributeRows = document.querySelectorAll('.attribute-row');
                attributeRows.forEach((row, index) => {
                    const nameInput = row.querySelector('.attribute-name');
                    const valueInput = row.querySelector('.attribute-value');
                    const idInput = row.querySelector('input[name*=".Id"]');
                    const productIdInput = row.querySelector('input[name*=".ProductId"]');

                    nameInput.name = `Attributes[${index}].AttributeName`;
                    valueInput.name = `Attributes[${index}].AttributeValue`;
                    idInput.name = `Attributes[${index}].Id`;
                    productIdInput.name = `Attributes[${index}].ProductId`;
                });
            }

            // Update attribute count
            function updateAttributeCount() {
                if (attributeCount) {
                    const count = document.querySelectorAll('.attribute-row').length;
                    attributeCount.textContent = count;
                }
            }

            // Initialize
            updateAttributeCount();
        });

        // Image upload functionality
        document.addEventListener('DOMContentLoaded', function() {
            const productImagesInput = document.getElementById('productImages');
            const imageDropzone = document.getElementById('imageDropzone');
            const noImagesMessage = document.getElementById('noImagesMessage');
            const imagePreviewsContainer = document.getElementById('imagePreviewsContainer');
            const clearImagesBtn = document.getElementById('clearImagesBtn');
            const imageCount = document.getElementById('imageCount');

            // Handle file selection
            productImagesInput?.addEventListener('change', function(e) {
                handleFiles(this.files);
            });

            // Handle drag and drop
            imageDropzone?.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.classList.add('dragover');
            });

            imageDropzone?.addEventListener('dragleave', function(e) {
                e.preventDefault();
                this.classList.remove('dragover');
            });

            imageDropzone?.addEventListener('drop', function(e) {
                e.preventDefault();
                this.classList.remove('dragover');

                if (e.dataTransfer.files.length > 0) {
                    handleFiles(e.dataTransfer.files);
                }
            });

            // Handle files function
            function handleFiles(files) {
                if (files.length === 0) return;

                // Hide no images message
                if (noImagesMessage) {
                    noImagesMessage.style.display = 'none';
                }

                // Show previews container
                if (imagePreviewsContainer) {
                    imagePreviewsContainer.style.display = 'flex';
                }

                // Enable clear button
                if (clearImagesBtn) {
                    clearImagesBtn.disabled = false;
                }

                // Process each file
                Array.from(files).forEach((file, index) => {
                    // Check if file is an image
                    if (!file.type.match('image.*')) return;

                    // Check file size (max 5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert(`File ${file.name} is too large. Maximum size is 5MB.`);
                        return;
                    }

                    // Create a unique ID for the file
                    const fileId = `image-${Date.now()}-${index}`;

                    // Create file reader to generate preview
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        // Create preview element
                        const previewCol = document.createElement('div');
                        previewCol.className = 'col-md-6 col-lg-4';
                        previewCol.innerHTML = `
                            <div class="image-preview-item">
                                <div class="image-preview-primary">
                                    <span class="badge bg-primary ${index === 0 ? '' : 'd-none'}">Primary</span>
                                </div>
                                <div class="image-preview-actions">
                                    <button type="button" class="btn btn-sm btn-light set-primary" title="Set as primary" ${index === 0 ? 'disabled' : ''}>
                                        <i class="bi bi-star"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger remove-image" title="Remove image">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <img src="${e.target.result}" class="img-fluid" style="width: 100%; height: 150px; object-fit: contain;" alt="Product image preview" />
                                <input type="hidden" name="ImageFiles" value="${fileId}" />
                                <div class="p-2 bg-light">
                                    <input type="text" class="form-control form-control-sm" name="ImageAlts" placeholder="Alt text (optional)" />
                                </div>
                            </div>
                        `;

                        // Add to previews container
                        imagePreviewsContainer.appendChild(previewCol);

                        // Create a new FormData object
                        const formData = new FormData();
                        formData.append('file', file);

                        // Store the file in the form for submission
                        // This is a simplified approach - in a real app, you might want to use FormData
                        // to upload the files via AJAX or handle them differently

                        // Update image count
                        updateImageCount();
                    };

                    // Read the file as a data URL
                    reader.readAsDataURL(file);
                });
            }

            // Set primary image
            imagePreviewsContainer?.addEventListener('click', function(e) {
                if (e.target.classList.contains('set-primary') || e.target.closest('.set-primary')) {
                    const button = e.target.classList.contains('set-primary') ? e.target : e.target.closest('.set-primary');
                    const previewItem = button.closest('.image-preview-item');

                    // Remove primary from all images
                    const allPrimaryBadges = document.querySelectorAll('.image-preview-primary .badge');
                    allPrimaryBadges.forEach(badge => badge.classList.add('d-none'));

                    const allPrimaryButtons = document.querySelectorAll('.set-primary');
                    allPrimaryButtons.forEach(btn => btn.disabled = false);

                    // Set this image as primary
                    const primaryBadge = previewItem.querySelector('.image-preview-primary .badge');
                    primaryBadge.classList.remove('d-none');
                    button.disabled = true;
                }
            });

            // Remove image
            imagePreviewsContainer?.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-image') || e.target.closest('.remove-image')) {
                    const previewCol = e.target.closest('.col-md-6');

                    // Add fade out animation
                    previewCol.style.opacity = '0';
                    previewCol.style.transform = 'translateY(-10px)';

                    setTimeout(() => {
                        previewCol.remove();

                        // Show no images message if no images left
                        if (imagePreviewsContainer.children.length === 0) {
                            if (noImagesMessage) {
                                noImagesMessage.style.display = 'block';
                            }

                            imagePreviewsContainer.style.display = 'none';

                            // Disable clear button
                            if (clearImagesBtn) {
                                clearImagesBtn.disabled = true;
                            }
                        } else {
                            // Ensure there's always a primary image
                            const hasPrimary = document.querySelector('.image-preview-primary .badge:not(.d-none)');
                            if (!hasPrimary && imagePreviewsContainer.children.length > 0) {
                                const firstItem = imagePreviewsContainer.children[0].querySelector('.image-preview-item');
                                const primaryBadge = firstItem.querySelector('.image-preview-primary .badge');
                                primaryBadge.classList.remove('d-none');

                                const primaryButton = firstItem.querySelector('.set-primary');
                                primaryButton.disabled = true;
                            }
                        }

                        // Update image count
                        updateImageCount();
                    }, 300);
                }
            });

            // Clear all images
            clearImagesBtn?.addEventListener('click', function() {
                if (confirm('Are you sure you want to remove all images?')) {
                    // Clear file input
                    if (productImagesInput) {
                        productImagesInput.value = '';
                    }

                    // Clear previews
                    if (imagePreviewsContainer) {
                        imagePreviewsContainer.innerHTML = '';
                        imagePreviewsContainer.style.display = 'none';
                    }

                    // Show no images message
                    if (noImagesMessage) {
                        noImagesMessage.style.display = 'block';
                    }

                    // Disable clear button
                    this.disabled = true;

                    // Update image count
                    updateImageCount();
                }
            });

            // Update image count
            function updateImageCount() {
                if (imageCount) {
                    const count = imagePreviewsContainer.children.length;
                    imageCount.textContent = count;
                }
            }

            // Initialize
            updateImageCount();
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}