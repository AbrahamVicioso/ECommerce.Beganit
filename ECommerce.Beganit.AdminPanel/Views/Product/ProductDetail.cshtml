@model ECommerce.Beganit.AdminPanel.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <!-- Header -->
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Details</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-0">@Model.Name</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="actionDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="actionDropdown">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-copy me-2"></i>Duplicate</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-print me-2"></i>Print Details</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" asp-action="DisableProduct" asp-route-id="@Model?.Id"><i class="fas fa-ban me-2"></i>Disable Product</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Product Image and Key Info -->
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            @if(@Model.ProductImages.Count > 0){
                                <img src="@Model.ProductImages.First(x => x.IsPrimary == true).ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3" style="max-height: 250px;">
                            }
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Status</h5>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">
                                        <i class="fas fa-check-circle me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                        <i class="fas fa-ban me-1"></i> Inactive
                                    </span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Stock</h5>
                                @{
                                    string stockClass = "bg-success";
                                    string stockIcon = "fas fa-check-circle";
                                    string stockText = "In Stock";

                                    if (Model.Quantity <= 0)
                                    {
                                        stockClass = "bg-danger";
                                        stockIcon = "fas fa-times-circle";
                                        stockText = "Out of Stock";
                                    }
                                    else if (Model.Quantity < 10)
                                    {
                                        stockClass = "bg-warning";
                                        stockIcon = "fas fa-exclamation-circle";
                                        stockText = "Low Stock";
                                    }
                                }
                                <span class="badge @stockClass px-3 py-2 rounded-pill">
                                    <i class="@stockIcon me-1"></i> @stockText
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Featured</h5>
                                @if (Model.IsFeatured)
                                {
                                    <span class="badge bg-primary px-3 py-2 rounded-pill">
                                        <i class="fas fa-star me-1"></i> Featured
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                        <i class="far fa-star me-1"></i> Not Featured
                                    </span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">SKU</h5>
                                <span class="badge bg-light text-dark px-3 py-2 border">@Model.Sku</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Details -->
                <div class="col-lg-8">
                    <div class="row">
                        <!-- Basic Information -->
                        <div class="col-12 mb-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Basic Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-md-3 fw-bold text-muted">Name:</div>
                                        <div class="col-md-9">@Model.Name</div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-3 fw-bold text-muted">Slug:</div>
                                        <div class="col-md-9">
                                            <code>@Model.Slug</code>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-3 fw-bold text-muted">Brand:</div>
                                        <div class="col-md-9">
                                            @if (Model.Brand != null)
                                            {
                                                @Model.Brand.Name
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-3 fw-bold text-muted">Short Description:</div>
                                        <div class="col-md-9">
                                            @if (!string.IsNullOrEmpty(Model.ShortDescription))
                                            {
                                                @Model.ShortDescription
                                            }
                                            else
                                            {
                                                <span class="text-muted">No short description</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-3 fw-bold text-muted">Description:</div>
                                        <div class="col-md-9">
                                            @if (!string.IsNullOrEmpty(Model.Description))
                                            {
                                                <div class="p-3 bg-light rounded">@Model.Description</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No description</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing Information -->
                        <div class="col-md-6 mb-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Pricing</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-6 fw-bold text-muted">Regular Price:</div>
                                        <div class="col-6 fw-bold fs-5">$@Model.RegularPrice.ToString("N2")</div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-6 fw-bold text-muted">Discount Price:</div>
                                        <div class="col-6">
                                            @if (Model.DiscountPrice.HasValue)
                                            {
                                                <span class="fw-bold fs-5 text-danger">$@Model.DiscountPrice.Value.ToString("N2")</span>
                                                <div class="small text-success">
                                                    @{
                                                        var savings = Model.RegularPrice - Model.DiscountPrice.Value;
                                                        var savingsPercent = (savings / Model.RegularPrice) * 100;
                                                    }
                                                    Save $@savings.ToString("N2") (@savingsPercent.ToString("N0")%)
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No discount</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 fw-bold text-muted">Discount Period:</div>
                                        <div class="col-6">
                                            @if (Model.DiscountStartDate.HasValue && Model.DiscountEndDate.HasValue)
                                            {
                                                <div class="d-flex flex-column">
                                                    <small class="text-muted">From: @Html.DisplayFor(m => m.DiscountStartDate)</small>
                                                    <small class="text-muted">To: @Html.DisplayFor(m => m.DiscountEndDate)</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not set</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Inventory Information -->
                        <div class="col-md-6 mb-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Inventory</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-6 fw-bold text-muted">Quantity:</div>
                                        <div class="col-6">
                                            <span class="fw-bold fs-5 @(Model.Quantity > 0 ? (Model.Quantity < 10 ? "text-warning" : "text-success") : "text-danger")">
                                                @Model.Quantity
                                            </span>
                                            <span class="text-muted">units</span>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-6 fw-bold text-muted">Weight:</div>
                                        <div class="col-6">@Model.Weight kg</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 fw-bold text-muted">Dimensions:</div>
                                        <div class="col-6">
                                            <div class="d-flex flex-column">
                                                <span>Length: @Model.Length cm</span>
                                                <span>Width: @Model.Width cm</span>
                                                <span>Height: @Model.Height cm</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Administrative Information -->
                        <div class="col-12 mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">Administrative Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="row mb-2">
                                                <div class="col-md-4 fw-bold text-muted">Created By:</div>
                                                <div class="col-md-8">
                                                    
                                                </div>
                                            </div>
                                            <div class="row mb-2">
                                                <div class="col-md-4 fw-bold text-muted">Created At:</div>
                                                <div class="col-md-8">@Html.DisplayFor(m => m.CreatedAt)</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="row mb-2">
                                                <div class="col-md-4 fw-bold text-muted">Updated By:</div>
                                                <div class="col-md-8">
                                                    
                                                </div>
                                            </div>
                                            <div class="row mb-2">
                                                <div class="col-md-4 fw-bold text-muted">Updated At:</div>
                                                <div class="col-md-8">@Html.DisplayFor(m => m.UpdatedAt)</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer with Actions -->
        <div class="card-footer bg-white d-flex justify-content-between py-3">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
            <div>
                <a asp-action="EditProduct" asp-route-id="@Model?.Id" class="btn btn-primary me-2">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
                <a href="#" class="btn btn-outline-success">
                    <i class="fas fa-shopping-cart me-1"></i> View in Store
                </a>
            </div>
        </div>
    </div>
</div>