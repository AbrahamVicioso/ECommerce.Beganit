@model ECommerce.Beganit.AdminPanel.Models.ViewModels.UploadProductImageViewModel

@{
    ViewData["Title"] = "Upload Product Image";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-1">
                                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
                                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">Product Details</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Upload Image</li>
                            </ol>
                        </nav>
                        <h1 class="h3 mb-0">Upload Product Image</h1>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-controller="Product" asp-action="UploadImage" method="post" enctype="multipart/form-data" id="uploadForm">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.ProductId)

                        <div class="row">
                            <!-- Image Preview and Upload -->
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="card-body text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 300px;">
                                        <div id="imagePreviewContainer" class="mb-3 d-none">
                                            <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded shadow-sm" style="max-height: 200px;">
                                            <button type="button" id="removeImage" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>

                                        <div id="uploadPlaceholder">
                                            <i class="fas fa-cloud-upload-alt text-primary mb-3" style="font-size: 3rem;"></i>
                                            <h5>Upload Product Image</h5>
                                            <p class="text-muted small">Supported formats: JPG, PNG, GIF<br>Max size: 5MB</p>

                                            <div class="mt-3">
                                                <label for="Image" class="btn btn-outline-primary">
                                                    <i class="fas fa-folder-open me-2"></i> Browse Files
                                                </label>
                                                @* @Html.TextBoxFor(m => m.Image, new { @class = "d-none", type = "file", accept = "image/*" }) *@
                                            </div>
                                        </div>

                                        <div class="mt-3 small text-danger">
                                            @* @Html.ValidationMessageFor(m => m.Image) *@
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Image Details -->
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-0">
                                    <div class="card-body">
                                        <h5 class="card-title mb-4">Image Details</h5>

                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                @Html.CheckBoxFor(m => m.IsPrimary, new { @class = "form-check-input", role = "switch" })
                                                <label class="form-check-label" for="IsPrimary">
                                                    Set as Primary Image
                                                    <i class="fas fa-question-circle text-muted ms-1"
                                                       data-bs-toggle="tooltip"
                                                       title="The primary image will be displayed as the main product image in listings and detail pages."></i>
                                                </label>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="DisplayOrder" class="form-label">Display Order</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fas fa-sort-numeric-down"></i></span>
                                                @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "1" })
                                            </div>
                                            <div class="form-text text-muted">
                                                Determines the order in which images are displayed. Lower numbers appear first.
                                            </div>
                                            <div class="text-danger">
                                                @Html.ValidationMessageFor(m => m.DisplayOrder)
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="AltText" class="form-label">
                                                Alternative Text
                                                <i class="fas fa-question-circle text-muted ms-1"
                                                   data-bs-toggle="tooltip"
                                                   title="Alt text is important for accessibility and SEO. Describe what's in the image."></i>
                                            </label>
                                            @Html.TextAreaFor(m => m.AltText, new { @class = "form-control", rows = "3", placeholder = "Describe the image content for accessibility" })
                                            <div class="form-text text-muted">
                                                Provide a descriptive text of the image for screen readers and SEO.
                                            </div>
                                            <div class="text-danger">
                                                @Html.ValidationMessageFor(m => m.AltText)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="fas fa-info-circle me-2 fs-4"></i>
                            <div>
                                <strong>Image Guidelines:</strong>
                                <ul class="mb-0 ps-3">
                                    <li>Use high-quality images with good lighting</li>
                                    <li>Maintain consistent aspect ratios across product images</li>
                                    <li>Recommended size: 1200 × 1200 pixels</li>
                                </ul>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-white d-flex justify-content-between py-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" form="uploadForm" class="btn btn-primary">
                        <i class="fas fa-cloud-upload-alt me-1"></i> Upload Image
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Image preview functionality
            $("#Image").change(function() {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();

                    reader.onload = function(e) {
                        $("#imagePreview").attr("src", e.target.result);
                        $("#imagePreviewContainer").removeClass("d-none");
                        $("#uploadPlaceholder").addClass("d-none");

                        // Auto-generate alt text based on filename if empty
                        if ($("#AltText").val() === "") {
                            var fileName = $("#Image").val().split("\\").pop().split(".")[0];
                            // Convert filename to readable format (replace dashes and underscores with spaces, capitalize words)
                            fileName = fileName.replace(/[-_]/g, " ")
                                .replace(/\w\S*/g, function(txt) {
                                    return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
                                });
                            $("#AltText").val(fileName);
                        }
                    }

                    reader.readAsDataURL(this.files[0]);

                    // Validate file size
                    var fileSize = this.files[0].size / 1024 / 1024; // in MB
                    if (fileSize > 5) {
                        alert("File size exceeds 5MB. Please choose a smaller file.");
                        $(this).val(""); // Clear the file input
                        $("#imagePreviewContainer").addClass("d-none");
                        $("#uploadPlaceholder").removeClass("d-none");
                    }
                }
            });

            // Remove image button
            $("#removeImage").click(function() {
                $("#Image").val("");
                $("#imagePreviewContainer").addClass("d-none");
                $("#uploadPlaceholder").removeClass("d-none");
            });

            // Form validation
            $("#uploadForm").submit(function(e) {
                if ($("#Image").val() === "") {
                    e.preventDefault();
                    alert("Please select an image file to upload.");
                    return false;
                }

                if ($("#AltText").val() === "") {
                    if (!confirm("Alternative text is empty. This is important for accessibility. Continue anyway?")) {
                        e.preventDefault();
                        $("#AltText").focus();
                        return false;
                    }
                }

                return true;
            });
        });
    </script>
}