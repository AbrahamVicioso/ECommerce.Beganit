@model ECommerce.Beganit.AdminPanel.Models.ViewModels.BrandViewModel
@{
    ViewData["Title"] = $"Brand: {Model.Name}";
}

<div class="container-fluid py-4">
    <!-- Hero Section -->
    <div class="position-relative mb-5">
        <div class="card bg-dark text-white border-0 overflow-hidden">
            <div class="brand-header-bg" style="background-color: #f8f9fa; height: 200px; opacity: 0.2;"></div>
            <div class="card-img-overlay d-flex align-items-center">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="brand-logo-container bg-white rounded-circle p-2 shadow-lg border border-3 border-primary">
                                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                {
                                    <img src="@Model.LogoUrl" alt="@Model.Name Logo" class="rounded-circle" style="width: 100px; height: 100px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light rounded-circle" style="width: 100px; height: 100px;">
                                        <i class="bi bi-building fs-1 text-primary"></i>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col">
                            <h1 class="display-4 fw-bold text-white mb-0">@Model.Name</h1>
                            <div class="d-flex align-items-center mt-2">
                                <span class="badge rounded-pill @(Model.IsActive ? "bg-success" : "bg-danger") fs-6 px-3 py-2 me-3">
                                    <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                                <span class="text-white-50">
                                    <i class="bi bi-calendar3 me-1"></i> Created: @(Model.CreatedAt?.ToString("MMM dd, yyyy") ?? "Not available")
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="d-flex">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn me-2 rounded-pill shadow-sm">
                                    <i class="bi bi-pencil-fill me-2"></i> Edit Brand
                                </a>
                                <a asp-action="Index" class="btn btn-light btn rounded-pill shadow-sm">
                                    <i class="bi bi-arrow-left me-2"></i> Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Information Card -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4">
                    <ul class="nav nav-tabs card-header-tabs" id="brandTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" aria-controls="overview" aria-selected="true">
                                <i class="bi bi-info-circle-fill me-2"></i>Overview
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab" aria-controls="history" aria-selected="false">
                                <i class="bi bi-clock-history me-2"></i>History
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="products-tab" data-bs-toggle="tab" data-bs-target="#products" type="button" role="tab" aria-controls="products" aria-selected="false">
                                <i class="bi bi-box-seam me-2"></i>Products
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <div class="tab-content" id="brandTabsContent">
                        <!-- Overview Tab -->
                        <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
                            <div class="row">
                                <div class="col-md-12 mb-4">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="bi bi-file-text-fill me-2 text-primary"></i>Description
                                            </h5>
                                            @if (!string.IsNullOrEmpty(Model.Description))
                                            {
                                                <p class="card-text lead">@Model.Description</p>
                                            }
                                            else
                                            {
                                                <div class="alert alert-light border mb-0">
                                                    <i class="bi bi-info-circle me-2"></i>No description available for this brand.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <div class="card h-100 border-0 bg-primary bg-opacity-10">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="bi bi-link-45deg me-2 text-primary"></i>Brand Resources
                                            </h5>
                                            <ul class="list-group list-group-flush">
                                                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                                {
                                                    <li class="list-group-item bg-transparent px-0">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-image me-2"></i>Logo URL</span>
                                                            <div class="btn-group">
                                                                <a href="@Model.LogoUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                    <i class="bi bi-eye-fill"></i>
                                                                </a>
                                                                <button type="button" class="btn btn-sm btn-outline-primary copy-btn" data-clipboard-text="@Model.LogoUrl">
                                                                    <i class="bi bi-clipboard"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }
                                                <li class="list-group-item bg-transparent px-0">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span><i class="bi bi-globe me-2"></i>Brand Page</span>
                                                        <a href="#" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-box-arrow-up-right"></i> View
                                                        </a>
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <div class="card h-100 border-0 bg-success bg-opacity-10">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <i class="bi bi-graph-up me-2 text-success"></i>Brand Performance
                                            </h5>
                                            <div class="d-flex justify-content-around text-center my-4">
                                                <div>
                                                    <div class="display-6 fw-bold text-success">24</div>
                                                    <div class="text-muted small">Products</div>
                                                </div>
                                                <div>
                                                    <div class="display-6 fw-bold text-success">1.2k</div>
                                                    <div class="text-muted small">Views</div>
                                                </div>
                                                <div>
                                                    <div class="display-6 fw-bold text-success">$9.4k</div>
                                                    <div class="text-muted small">Revenue</div>
                                                </div>
                                            </div>
                                            <div class="text-center mt-3">
                                                <a href="#" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-bar-chart-fill me-1"></i> View Analytics
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- History Tab -->
                        <div class="tab-pane fade" id="history" role="tabpanel" aria-labelledby="history-tab">
                            <div class="timeline position-relative">
                                <!-- Creation Event -->
                                <div class="timeline-item">
                                    <div class="timeline-point bg-success"></div>
                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex">
                                                <div class="bg-success text-white rounded-circle p-3 me-3">
                                                    <i class="bi bi-plus-lg fs-4"></i>
                                                </div>
                                                <div>
                                                    <h5 class="card-title">Brand Created</h5>
                                                    <h6 class="card-subtitle mb-2 text-muted">
                                                        @(Model.CreatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "Date not available")
                                                    </h6>
                                                    <p class="card-text">
                                                        Brand was created
                                                        @if (Model.CreatedBy.HasValue)
                                                        {
                                                            <span>by User #@Model.CreatedBy</span>
                                                        }
                                                        else
                                                        {
                                                            <span>by system</span>
                                                        }
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Update Event (if applicable) -->
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-point bg-primary"></div>
                                        <div class="card mb-3 border-0 shadow-sm">
                                            <div class="card-body">
                                                <div class="d-flex">
                                                    <div class="bg-primary text-white rounded-circle p-3 me-3">
                                                        <i class="bi bi-pencil fs-4"></i>
                                                    </div>
                                                    <div>
                                                        <h5 class="card-title">Brand Updated</h5>
                                                        <h6 class="card-subtitle mb-2 text-muted">
                                                            @Model.UpdatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm")
                                                        </h6>
                                                        <p class="card-text">
                                                            Brand information was updated
                                                            @if (Model.UpdatedBy.HasValue)
                                                            {
                                                                <span>by User #@Model.UpdatedBy</span>
                                                            }
                                                            else
                                                            {
                                                                <span>by system</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Products Tab -->
                        <div class="tab-pane fade" id="products" role="tabpanel" aria-labelledby="products-tab">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="mb-0">Products from this Brand</h5>
                                <a href="#" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i> Add Product
                                </a>
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle-fill me-2"></i> This is a placeholder for brand products. In a real implementation, you would display products associated with this brand.
                            </div>

                            <div class="row g-3">
                                <!-- Sample Product Cards -->
                                @for (int i = 1; i <= 3; i++)
                                {
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm product-card">
                                            <div class="bg-light text-center p-3">
                                                <img src="/placeholder.svg" class="card-img-top product-img" alt="Product Image" style="height: 120px; object-fit: contain;">
                                            </div>
                                            <div class="card-body">
                                                <h6 class="card-title">Sample Product @i</h6>
                                                <p class="card-text text-muted small">Product description goes here...</p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold text-primary">$99.99</span>
                                                    <span class="badge bg-success">In Stock</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Side Information -->
        <div class="col-lg-4">
            <!-- Brand Status Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="p-4 @(Model.IsActive ? "bg-success" : "bg-danger") bg-opacity-10">
                        <div class="d-flex align-items-center">
                            <div class="@(Model.IsActive ? "bg-success" : "bg-danger") text-white rounded-circle p-3 me-3">
                                <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill") fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0 @(Model.IsActive ? "text-success" : "text-danger")">
                                    @(Model.IsActive ? "Active Brand" : "Inactive Brand")
                                </h5>
                                <p class="card-text text-muted mb-0">
                                    @(Model.IsActive ? "This brand is visible to customers" : "This brand is hidden from customers")
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="d-grid gap-2">
                            <a href="#" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                <i class="bi @(Model.IsActive ? "bi-toggle-off" : "bi-toggle-on") me-2"></i>
                                @(Model.IsActive ? "Deactivate Brand" : "Activate Brand")
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Brand Logo Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-image me-2 text-primary"></i>Brand Logo
                    </h5>
                </div>
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <div class="logo-display mb-3 p-4 bg-light rounded">
                            <img src="@Model.LogoUrl" alt="@Model.Name Logo" class="img-fluid brand-logo" style="max-height: 150px;" />
                        </div>
                        <div class="d-flex justify-content-center">
                            <a href="@Model.LogoUrl" target="_blank" class="btn btn-sm btn-outline-primary me-2">
                                <i class="bi bi-arrows-fullscreen me-1"></i> View Full Size
                            </a>
                            <a href="#" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-download me-1"></i> Download
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="logo-placeholder p-5 bg-light rounded mb-3">
                            <i class="bi bi-image fs-1 text-muted"></i>
                            <p class="text-muted mb-0">No logo available</p>
                        </div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="bi bi-cloud-upload me-1"></i> Upload Logo
                        </a>
                    }
                </div>
            </div>

            <!-- Quick Actions Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightning-charge me-2 text-primary"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="bi bi-plus-circle text-success me-3 fs-5"></i>
                            <div>
                                <strong>Add Product</strong>
                                <small class="d-block text-muted">Create a new product for this brand</small>
                            </div>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="bi bi-graph-up text-primary me-3 fs-5"></i>
                            <div>
                                <strong>View Analytics</strong>
                                <small class="d-block text-muted">See performance metrics</small>
                            </div>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="bi bi-megaphone text-warning me-3 fs-5"></i>
                            <div>
                                <strong>Promote Brand</strong>
                                <small class="d-block text-muted">Create marketing campaigns</small>
                            </div>
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="list-group-item list-group-item-action d-flex align-items-center text-danger">
                            <i class="bi bi-trash text-danger me-3 fs-5"></i>
                            <div>
                                <strong>Delete Brand</strong>
                                <small class="d-block text-muted">Remove this brand permanently</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Hero section styling */
        .brand-header-bg {
            background-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            filter: blur(8px);
        }

        .brand-logo-container {
            transition: all 0.3s ease;
        }

            .brand-logo-container:hover {
                transform: scale(1.05);
            }

        /* Timeline styling */
        .timeline {
            padding-left: 30px;
            border-left: 2px solid #e9ecef;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
        }

        .timeline-point {
            position: absolute;
            left: -41px;
            top: 20px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 0 0 2px #e9ecef;
        }

        /* Product card styling */
        .product-card {
            transition: all 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }

        .product-img {
            transition: all 0.3s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.05);
        }

        /* Logo display styling */
        .logo-display {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

            .logo-display:hover {
                border-color: #0d6efd;
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .brand-logo {
            transition: all 0.3s ease;
        }

        .logo-display:hover .brand-logo {
            transform: scale(1.05);
        }

        /* Tab styling */
        .nav-tabs .nav-link {
            border: none;
            color: #6c757d;
            padding: 0.75rem 1rem;
            font-weight: 500;
            border-bottom: 3px solid transparent;
        }

            .nav-tabs .nav-link.active {
                color: #0d6efd;
                background: transparent;
                border-bottom: 3px solid #0d6efd;
            }

            .nav-tabs .nav-link:hover:not(.active) {
                border-bottom: 3px solid #e9ecef;
            }

       
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Initialize clipboard functionality
            if (typeof ClipboardJS !== 'undefined') {
                new ClipboardJS('.copy-btn').on('success', function(e) {
                    const originalText = $(e.trigger).html();
                    $(e.trigger).html('<i class="bi bi-check-lg"></i>');
                    setTimeout(function() {
                        $(e.trigger).html(originalText);
                    }, 1500);
                });
            }

            // Add animation to elements when they come into view
            const animateOnScroll = function() {
                $('.card').each(function() {
                    const position = $(this).offset().top;
                    const scroll = $(window).scrollTop();
                    const windowHeight = $(window).height();

                    if (scroll + windowHeight > position + 100) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                    }
                });
            };

            // Run on page load
            animateOnScroll();

            // Run on scroll
            $(window).scroll(function() {
                animateOnScroll();
            });
        });
    </script>
}