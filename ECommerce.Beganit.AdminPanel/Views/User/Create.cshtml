@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Crear Usuario";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Información del Usuario</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Nombre de Usuario</label>
                        <input asp-for="UserName" class="form-control" required />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label for="Password" class="form-label">Contraseña</label>
                        <input name="Password" id="Password" class="form-control" type="password" required />
                        <span class="text-muted">La contraseña debe tener al menos 6 caracteres y contener letras mayúsculas, minúsculas, números y caracteres especiales.</span>
                    </div>
                    
                    <div class="mb-3">
                        <label for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                        <input name="ConfirmPassword" id="ConfirmPassword" class="form-control" type="password" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Número de Teléfono</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    
                    <hr />
                    
                    <h5>Configuración de Seguridad</h5>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="EmailConfirmed" class="form-check-input" />
                        <label asp-for="EmailConfirmed" class="form-check-label">Marcar correo como confirmado</label>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="PhoneNumberConfirmed" class="form-check-input" />
                        <label asp-for="PhoneNumberConfirmed" class="form-check-label">Marcar teléfono como confirmado</label>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="TwoFactorEnabled" class="form-check-input" />
                        <label asp-for="TwoFactorEnabled" class="form-check-label">Habilitar autenticación de dos factores</label>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="LockoutEnabled" class="form-check-input" checked />
                        <label asp-for="LockoutEnabled" class="form-check-label">Habilitar bloqueo por intentos fallidos</label>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-person-plus"></i> Crear Usuario
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a la Lista
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Información Adicional</h5>
            </div>
            <div class="card-body">
                <p>Al crear un nuevo usuario:</p>
                <ul>
                    <li>Se generará automáticamente un ID único</li>
                    <li>Se generará un Security Stamp para la seguridad de la cuenta</li>
                    <li>Se establecerá un Concurrency Stamp para control de concurrencia</li>
                </ul>
                <p>Si marca el correo electrónico como confirmado, el usuario no necesitará verificar su dirección de correo.</p>
                <p>La autenticación de dos factores requerirá configuración adicional por parte del usuario una vez creada la cuenta.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Validación personalizada para confirmar que las contraseñas coinciden
            $("#ConfirmPassword").on("input", function() {
                var password = $("#Password").val();
                var confirmPassword = $(this).val();
                
                if (password !== confirmPassword) {
                    $(this).addClass("is-invalid");
                    $(this).removeClass("is-valid");
                } else {
                    $(this).removeClass("is-invalid");
                    $(this).addClass("is-valid");
                }
            });
            
            // Validación de contraseña compleja
            $("#Password").on("input", function() {
                var password = $(this).val();
                var hasUpperCase = /[A-Z]/.test(password);
                var hasLowerCase = /[a-z]/.test(password);
                var hasNumbers = /\d/.test(password);
                var hasSpecial = /[!@@#$%^&*(),.?":{}|<>]/.test(password);
                var isValid = password.length >= 6 && hasUpperCase && hasLowerCase && hasNumbers && hasSpecial;
                
                if (!isValid) {
                    $(this).addClass("is-invalid");
                    $(this).removeClass("is-valid");
                } else {
                    $(this).removeClass("is-invalid");
                    $(this).addClass("is-valid");
                }
            });
        });
    </script>
}