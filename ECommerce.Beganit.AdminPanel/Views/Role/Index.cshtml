@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Roles</h2>

<p>
    @Html.ActionLink("Crear Nuevo Rol", "Create", null, new { @class = "btn btn-primary" })
</p>

<div class="panel panel-default">
    <div class="panel-heading">
        Lista de Roles
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="2">No hay roles disponibles.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                                @Html.ActionLink("Detalles", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-default" })
                                @* @using (Html.BeginForm("Delete", "Roles", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" })) *@
                                @* { *@
                                @*     @Html.AntiForgeryToken() *@
                                @*     <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro que desea eliminar este rol?');"> *@
                                @*         Eliminar *@
                                @*     </button> *@
                                @* } *@
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>