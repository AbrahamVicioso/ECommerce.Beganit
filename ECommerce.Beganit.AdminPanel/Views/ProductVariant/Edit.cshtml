@model ECommerce.Beganit.AdminPanel.Models.ViewModels.ProductVariantViewModel

@{
    ViewData["Title"] = "Edit Product Variant";
    var products = ViewBag.Products as List<Product>;
}

<div class="container-fluid py-4">
    <!-- Header Banner -->
    <div class="bg-primary text-white rounded-3 mb-4 p-4">
        <div class="d-flex align-items-center">
            <div class="bg-white rounded-circle p-3 me-3">
                <i class="bi bi-box-seam text-primary fs-3"></i>
            </div>
            <div>
                <h1 class="mb-0">Edit Product Variant</h1>
                <p class="mb-0 opacity-75">Update variant details in your product catalog</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column - Form -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                            <i class="bi bi-info-circle text-primary"></i>
                        </div>
                        <h5 class="card-title mb-0">Variant Information</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editVariantForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                        <input type="hidden" asp-for="Id" />

                        <!-- Product Selection -->
                        <div class="mb-4">
                            <label class="d-flex align-items-center mb-2">
                                <i class="bi bi-tag me-2"></i>
                                <span>Select Product</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-search"></i>
                                </span>
                                <select asp-for="ProductId" class="form-select">
                                    <option value="">- Select Product -</option>
                                    @foreach(Product product in products){
                                        <option value="@product.Id">@product.Name</option>
                                    }
                                </select>
                                <a href="#" class="btn btn-outline-secondary" data-bs-toggle="tooltip" title="View Product Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                            <span asp-validation-for="ProductId" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle-fill me-1 small"></i>
                                Select the product this variant belongs to
                            </div>
                        </div>

                        <!-- SKU -->
                        <div class="mb-4">
                            <label asp-for="Sku" class="d-flex align-items-center mb-2">
                                <i class="bi bi-upc-scan me-2"></i>
                                <span>SKU (Stock Keeping Unit)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input asp-for="Sku" class="form-control" placeholder="e.g. PROD-VAR-001" />
                            </div>
                            <span asp-validation-for="Sku" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle-fill me-1 small"></i>
                                Unique identifier for inventory management
                            </div>
                        </div>

                        <!-- Price -->
                        <div class="mb-4">
                            <label asp-for="Price" class="d-flex align-items-center mb-2">
                                <i class="bi bi-currency-dollar me-2"></i>
                                <span>Price</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle-fill me-1 small"></i>
                                Retail price for this variant
                            </div>
                        </div>

                        <!-- Quantity -->
                        <div class="mb-4">
                            <label asp-for="Quantity" class="d-flex align-items-center mb-2">
                                <i class="bi bi-boxes me-2"></i>
                                <span>Quantity in Stock</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-123"></i>
                                </span>
                                <input asp-for="Quantity" type="number" min="0" class="form-control" placeholder="0" />
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle-fill me-1 small"></i>
                                Available inventory quantity
                            </div>
                        </div>

                        <!-- Is Active -->
                        <div class="mb-4">
                            <label class="d-flex align-items-center mb-3">
                                <i class="bi bi-toggle-on me-2"></i>
                                <span>Variant Status</span>
                            </label>
                            <div class="form-check form-switch form-switch-lg">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch">
                                    <span id="statusText" class="fw-medium"></span>
                                    <small class="text-muted d-block" id="statusDescription"></small>
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column - Preview -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px; z-index: 100;">
                <div class="card-header bg-light py-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                            <i class="bi bi-eye text-primary"></i>
                        </div>
                        <h5 class="card-title mb-0">Variant Preview</h5>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Preview Content -->
                    <div class="text-center mb-4">
                        <div class="variant-preview bg-light rounded p-4 mb-3">
                            <div class="product-placeholder mb-3">
                                <i class="bi bi-box-seam fs-1 text-primary"></i>
                            </div>
                            <h5 id="previewProductName" class="mb-1">Select a product</h5>
                            <p id="previewSku" class="text-muted small mb-2">SKU: @Model.Sku</p>
                            <div class="d-flex justify-content-center align-items-center mb-2">
                                <span id="previewPrice" class="fs-3 fw-bold text-primary me-2">$@(Model.Price.ToString("0.00"))</span>
                                <span id="previewStatus" class="badge bg-success">Active</span>
                            </div>
                            <div class="inventory-indicator mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Stock Level:</span>
                                    <span id="previewQuantity">@Model.Quantity units</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div id="stockProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stock Status -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body p-3">
                            <h6 class="card-subtitle mb-2">
                                <i class="bi bi-graph-up me-2"></i>Stock Status
                            </h6>
                            <div id="stockStatusIndicator" class="d-flex align-items-center">
                                <div class="stock-icon bg-success text-white rounded-circle p-2 me-2">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <div>
                                    <span id="stockStatusText" class="fw-bold">In Stock</span>
                                    <small id="stockAdvice" class="text-muted d-block">Stock level is good</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="submit" form="editVariantForm" class="btn btn-primary btn-lg">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Custom styling */
        .form-switch-lg .form-check-input {
            width: 3em;
            height: 1.5em;
            margin-left: 0;
        }

        .variant-preview {
            border: 2px dashed #dee2e6;
            transition: all 0.3s ease;
        }

            .variant-preview:hover {
                border-color: #6c757d;
            }

        .product-placeholder {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            background-color: rgba(13, 110, 253, 0.1);
            border-radius: 50%;
        }

        .stock-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Animation for status change */
        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }

        }

        .pulse {
            animation: pulse 0.5s;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Set initial values
            updateStatusDisplay();
            updateStockStatus($("#Quantity").val());
            updateProgressBar($("#Quantity").val());

            // Product selection change
            $("#ProductId").change(function() {
                var selectedOption = $(this).find("option:selected");
                if (selectedOption.val()) {
                    $("#previewProductName").text(selectedOption.text());
                    $(".variant-preview").addClass("border-primary").removeClass("border-dashed");
                    $(".product-placeholder").addClass("bg-primary bg-opacity-10");
                } else {
                    $("#previewProductName").text("Select a product");
                    $(".variant-preview").removeClass("border-primary").addClass("border-dashed");
                    $(".product-placeholder").removeClass("bg-primary bg-opacity-10");
                }
            });

            // Trigger change to set initial product name
            $("#ProductId").trigger("change");

            // SKU input change
            $("#Sku").on("input", function() {
                var sku = $(this).val() || "-";
                $("#previewSku").text("SKU: " + sku);
            });

            // Price input change
            $("#Price").on("input", function() {
                var price = parseFloat($(this).val()) || 0;
                $("#previewPrice").text("$" + price.toFixed(2));

                // Add animation
                $("#previewPrice").addClass("pulse");
                setTimeout(function() {
                    $("#previewPrice").removeClass("pulse");
                }, 500);
            });

            // Quantity input change
            $("#Quantity").on("input", function() {
                var quantity = parseInt($(this).val()) || 0;
                $("#previewQuantity").text(quantity + " units");

                // Update progress bar
                updateProgressBar(quantity);

                // Update stock status
                updateStockStatus(quantity);
            });

            // Status switch functionality
            $("#isActiveSwitch").change(function() {
                updateStatusDisplay();

                // Add animation
                $("#previewStatus").addClass("pulse");
                setTimeout(function() {
                    $("#previewStatus").removeClass("pulse");
                }, 500);
            });

            // Function to update status display
            function updateStatusDisplay() {
                if ($("#isActiveSwitch").is(":checked")) {
                    $("#statusText").text("Active").addClass("text-success").removeClass("text-danger");
                    $("#statusDescription").text("Variant is visible and available for purchase");
                    $("#previewStatus").removeClass("bg-danger").addClass("bg-success").text("Active");
                } else {
                    $("#statusText").text("Inactive").addClass("text-danger").removeClass("text-success");
                    $("#statusDescription").text("Variant is hidden and unavailable for purchase");
                    $("#previewStatus").removeClass("bg-success").addClass("bg-danger").text("Inactive");
                }
            }

            // Function to update progress bar
            function updateProgressBar(quantity) {
                var percentage = 0;
                if (quantity > 0) {
                    percentage = Math.min(quantity / 100 * 100, 100);
                }
                $("#stockProgressBar").css("width", percentage + "%");
            }

            // Function to update stock status
            function updateStockStatus(quantity) {
                var statusClass, statusText, statusIcon, advice;

                if (quantity <= 0) {
                    statusClass = "bg-danger";
                    statusText = "Out of Stock";
                    statusIcon = "bi-x-lg";
                    advice = "Restock needed immediately";
                } else if (quantity < 10) {
                    statusClass = "bg-warning";
                    statusText = "Low Stock";
                    statusIcon = "bi-exclamation-triangle";
                    advice = "Consider restocking soon";
                } else if (quantity < 50) {
                    statusClass = "bg-info";
                    statusText = "In Stock";
                    statusIcon = "bi-check-lg";
                    advice = "Stock level is adequate";
                } else {
                    statusClass = "bg-success";
                    statusText = "Well Stocked";
                    statusIcon = "bi-check-circle";
                    advice = "Stock level is good";
                }

                // Update the UI
                $("#stockStatusIndicator .stock-icon")
                    .removeClass("bg-danger bg-warning bg-info bg-success")
                    .addClass(statusClass)
                    .find("i")
                    .removeClass("bi-x-lg bi-exclamation-triangle bi-check-lg bi-check-circle")
                    .addClass(statusIcon);

                $("#stockStatusText").text(statusText);
                $("#stockAdvice").text(advice);
                $("#stockProgressBar")
                    .removeClass("bg-danger bg-warning bg-info bg-success")
                    .addClass(statusClass);
            }
        });
    </script>
}