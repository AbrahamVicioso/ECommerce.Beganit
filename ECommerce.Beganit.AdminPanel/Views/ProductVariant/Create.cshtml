@model ECommerce.Beganit.AdminPanel.Models.ViewModels.ProductVariantViewModel

@{
    ViewBag.Title = "Create Product Variant";
}

<div class="container-fluid py-4">
    <!-- Header Card -->
    <div class="card bg-gradient-primary text-white shadow-sm mb-4 border-0">
        <div class="card-body p-4">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-white p-3 me-3 shadow-sm">
                    <i class="bi bi-box-seam text-primary fs-3"></i>
                </div>
                <div>
                    <h1 class="mb-0">Create Product Variant</h1>
                    <p class="mb-0 opacity-75">Add a new variant to your product catalog</p>
                </div>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("Create", "ProductVariant", FormMethod.Post, new { id = "variantForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Main Form Card -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <h5 class="card-title mb-0">Variant Information</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Product Selection -->
                            <div class="col-md-12 mb-3">
                                <label for="ProductId" class="form-label fw-bold">
                                    <i class="bi bi-tag-fill me-2"></i>Select Product
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    @Html.DropDownListFor(model => model.ProductId,
                                             new SelectList(ViewBag.Products, "Id", "Name"),
                                             "- Select Product -",
                                             new { @class = "form-select form-select", required = "required" })
                                    <a href="#" class="btn btn-outline-secondary" data-bs-toggle="tooltip" title="View Product Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </div>
                                @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger" })
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i> Select the product this variant belongs to
                                </div>
                            </div>

                            <!-- SKU -->
                            <div class="col-md-6 mb-3">
                                <label for="Sku" class="form-label fw-bold">
                                    <i class="bi bi-upc-scan me-2"></i>SKU (Stock Keeping Unit)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-hash"></i>
                                    </span>
                                    @Html.TextBoxFor(model => model.Sku, new { @class = "form-control", placeholder = "e.g. PROD-VAR-001", required = "required" })
                                </div>
                                @Html.ValidationMessageFor(model => model.Sku, "", new { @class = "text-danger" })
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i> Unique identifier for inventory management
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="col-md-6 mb-3">
                                <label for="Price" class="form-label fw-bold">
                                    <i class="bi bi-currency-dollar me-2"></i>Price
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    @Html.TextBoxFor(model => model.Price,
                                             new
                                             {
                                                 @class = "form-control",
                                                 type = "number",
                                                 step = "0.01",
                                                 min = "0",
                                                 placeholder = "0.00",
                                                 required = "required"
                                             })
                                </div>
                                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i> Retail price for this variant
                                </div>
                            </div>

                            <!-- Quantity -->
                            <div class="col-md-6 mb-3">
                                <label for="Quantity" class="form-label fw-bold">
                                    <i class="bi bi-boxes me-2"></i>Quantity in Stock
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-123"></i>
                                    </span>
                                    @Html.TextBoxFor(model => model.Quantity,
                                             new
                                             {
                                                 @class = "form-control",
                                                 type = "number",
                                                 min = "0",
                                                 placeholder = "0",
                                                 required = "required"
                                             })
                                </div>
                                @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i> Available inventory quantity
                                </div>
                            </div>

                            <!-- Is Active -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold d-block mb-3">
                                    <i class="bi bi-toggle-on me-2"></i>Variant Status
                                </label>
                                <div class="form-check form-switch form-switch-lg">
                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input", role = "switch", id = "isActiveSwitch", @checked = "checked" })
                                    <div class="ps-3">
                                        <label class="form-check-label" for="isActiveSwitch">
                                            <span id="statusText" class="fw-bold text-success">Active</span>
                                            <small class="text-muted d-block" id="statusDescription">
                                                Variant is visible and available for purchase
                                            </small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preview Card -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px; z-index: 100;">
                    <div class="card-header bg-light py-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-eye-fill text-primary me-2"></i>
                            <h5 class="card-title mb-0">Variant Preview</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Preview Content -->
                        <div class="text-center mb-4">
                            <div class="variant-preview bg-light rounded p-4 mb-3">
                                <div class="product-placeholder mb-3">
                                    <i class="bi bi-box-seam fs-1 text-primary"></i>
                                </div>
                                <h5 id="previewProductName" class="mb-1">Select a product</h5>
                                <p id="previewSku" class="text-muted small mb-2">SKU: -</p>
                                <div class="d-flex justify-content-center align-items-center mb-2">
                                    <span id="previewPrice" class="fs-3 fw-bold text-primary me-2">$0.00</span>
                                    <span id="previewStatus" class="badge bg-success">Active</span>
                                </div>
                                <div class="inventory-indicator mb-2">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>Stock Level:</span>
                                        <span id="previewQuantity">0 units</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div id="stockProgressBar" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Stock Status -->
                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body p-3">
                                <h6 class="card-subtitle mb-2">
                                    <i class="bi bi-graph-up me-2"></i>Stock Status
                                </h6>
                                <div id="stockStatusIndicator" class="d-flex align-items-center">
                                    <div class="stock-icon bg-success text-white rounded-circle p-2 me-2">
                                        <i class="bi bi-check-lg"></i>
                                    </div>
                                    <div>
                                        <span id="stockStatusText" class="fw-bold">In Stock</span>
                                        <small id="stockAdvice" class="text-muted d-block">Stock level is good</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-plus-circle me-2"></i> Create Variant
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Custom styling */
        .form-switch-lg .form-check-input {
            width: 3em;
            height: 1.5em;
            margin-left: 0;
        }

        .variant-preview {
            border: 2px dashed #dee2e6;
            transition: all 0.3s ease;
        }

            .variant-preview:hover {
                border-color: #6c757d;
            }

        .product-placeholder {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            background-color: rgba(13, 110, 253, 0.1);
            border-radius: 50%;
        }

        .stock-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Animation for status change */
        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }

        }

        .pulse {
            animation: pulse 0.5s;
        }

        /* Gradient background */
        .bg-gradient-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Product selection change
            $("#ProductId").change(function() {
                var selectedOption = $(this).find("option:selected");
                if (selectedOption.val()) {
                    $("#previewProductName").text(selectedOption.text());
                    $(".variant-preview").addClass("border-primary").removeClass("border-dashed");
                    $(".product-placeholder").addClass("bg-primary bg-opacity-10");
                } else {
                    $("#previewProductName").text("Select a product");
                    $(".variant-preview").removeClass("border-primary").addClass("border-dashed");
                    $(".product-placeholder").removeClass("bg-primary bg-opacity-10");
                }
            });

            // SKU input change
            $("#Sku").on("input", function() {
                var sku = $(this).val() || "-";
                $("#previewSku").text("SKU: " + sku);
            });

            // Price input change
            $("#Price").on("input", function() {
                var price = parseFloat($(this).val()) || 0;
                $("#previewPrice").text("$" + price.toFixed(2));

                // Add animation
                $("#previewPrice").addClass("pulse");
                setTimeout(function() {
                    $("#previewPrice").removeClass("pulse");
                }, 500);
            });

            // Quantity input change
            $("#Quantity").on("input", function() {
                var quantity = parseInt($(this).val()) || 0;
                $("#previewQuantity").text(quantity + " units");

                // Update progress bar
                var percentage = 0;
                if (quantity > 0) {
                    percentage = Math.min(quantity / 100 * 100, 100);
                }
                $("#stockProgressBar").css("width", percentage + "%");

                // Update stock status
                updateStockStatus(quantity);
            });

            // Status switch functionality
            $("#isActiveSwitch").change(function() {
                if ($(this).is(":checked")) {
                    $("#statusText").text("Active").addClass("text-success").removeClass("text-danger");
                    $("#statusDescription").text("Variant is visible and available for purchase");
                    $("#previewStatus").removeClass("bg-danger").addClass("bg-success").text("Active");
                } else {
                    $("#statusText").text("Inactive").addClass("text-danger").removeClass("text-success");
                    $("#statusDescription").text("Variant is hidden and unavailable for purchase");
                    $("#previewStatus").removeClass("bg-success").addClass("bg-danger").text("Inactive");
                }

                // Add animation
                $("#previewStatus").addClass("pulse");
                setTimeout(function() {
                    $("#previewStatus").removeClass("pulse");
                }, 500);
            });

            // Function to update stock status
            function updateStockStatus(quantity) {
                var statusClass, statusText, statusIcon, advice;

                if (quantity <= 0) {
                    statusClass = "bg-danger";
                    statusText = "Out of Stock";
                    statusIcon = "bi-x-lg";
                    advice = "Restock needed immediately";
                } else if (quantity < 10) {
                    statusClass = "bg-warning";
                    statusText = "Low Stock";
                    statusIcon = "bi-exclamation-triangle";
                    advice = "Consider restocking soon";
                } else if (quantity < 50) {
                    statusClass = "bg-info";
                    statusText = "In Stock";
                    statusIcon = "bi-check-lg";
                    advice = "Stock level is adequate";
                } else {
                    statusClass = "bg-success";
                    statusText = "Well Stocked";
                    statusIcon = "bi-check-circle";
                    advice = "Stock level is good";
                }

                // Update the UI
                $("#stockStatusIndicator .stock-icon")
                    .removeClass("bg-danger bg-warning bg-info bg-success")
                    .addClass(statusClass)
                    .find("i")
                    .removeClass("bi-x-lg bi-exclamation-triangle bi-check-lg bi-check-circle")
                    .addClass(statusIcon);

                $("#stockStatusText").text(statusText);
                $("#stockAdvice").text(advice);
                $("#stockProgressBar")
                    .removeClass("bg-danger bg-warning bg-info bg-success")
                    .addClass(statusClass);
            }

            // Form validation styling enhancement
            $("#variantForm").on("submit", function() {
                $(this).addClass("was-validated");
            });
        });
    </script>
}