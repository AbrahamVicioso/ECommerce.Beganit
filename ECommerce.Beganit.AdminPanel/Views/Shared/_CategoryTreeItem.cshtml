@model dynamic
@{
    var category = Model.Category;
    var childCategories = Model.ChildCategories;
    var level = Model.Level;

    var hasChildren = childCategories.ContainsKey(category.Id) && childCategories[category.Id].Any();
    var isParent = level == 0;
    var rowClass = isParent ? "parent-category" : $"child-category level-{level}";
}

<tr class="category-row @rowClass" data-id="@category.Id" data-parent="@(level > 0 ? category.ParentCategoryId : null)">
    <td>
        <div class="d-flex align-items-center">
            @for (int i = 0; i < level; i++)
            {
                <span class="category-indent"></span>
            }

            @if (level > 0)
            {
                <span class="category-branch"></span>
            }

            @if (hasChildren)
            {
                <button class="toggle-children" data-id="@category.Id" title="Toggle subcategories">
                    <i class="fas fa-chevron-right"></i>
                </button>
            }
            else
            {
                <span style="width: 24px; margin-right: 0.5rem;"></span>
            }

            <div>
                <span class="category-name fw-medium">@category.Name</span>
                @if (category.IsFeatured)
                {
                    <span class="badge bg-warning text-dark ms-2">Featured</span>
                }
                @if (!string.IsNullOrEmpty(category.Description))
                {
                    <small class="d-block text-muted mt-1">@(category.Description.Length > 50 ? category.Description.Substring(0, 50) + "..." : category.Description)</small>
                }
            </div>
        </div>
    </td>
    <td class="category-slug">@category.Slug</td>
    <td class="category-order text-center">@category.DisplayOrder</td>
    <td>
        <span class="badge status-badge @(category.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
            @(category.IsActive ? "Active" : "Inactive")
        </span>
    </td>
    <td>
        <small class="text-muted">@(category.UpdatedAt?.ToString("MMM dd, yyyy") ?? category.CreatedAt.ToString("MMM dd, yyyy"))</small>
    </td>
    <td>
        <div class="action-buttons d-flex justify-content-end">
            <a href="/Category/Edit/@category.Id" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="tooltip" title="Edit Category">
                <i class="fas fa-edit"></i>
            </a>
            <button type="button" class="btn btn-sm btn-outline-info me-1 quick-edit-btn" data-id="@category.Id" data-bs-toggle="tooltip" title="Quick Edit">
                <i class="fas fa-pencil-alt"></i>
            </button>
            <div class="dropdown d-inline-block">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton@(category.Id)" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton@(category.Id)">
                    <li>
                        <a class="dropdown-item" href="/Category/Create?parentId=@category.Id">
                            <i class="fas fa-plus-circle me-2 text-success"></i>Add Subcategory
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/Category/Duplicate/@category.Id">
                            <i class="fas fa-copy me-2 text-primary"></i>Duplicate
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger delete-btn" data-id="@category.Id">
                            <i class="fas fa-trash-alt me-2"></i>Delete
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </td>
</tr>

@if (hasChildren)
{
    foreach (var childCategory in childCategories[category.Id])
    {
        @await Html.PartialAsync("_CategoryTreeItem", new { Category = childCategory, ChildCategories = childCategories, Level = level + 1 })
    }
}